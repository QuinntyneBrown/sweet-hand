  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.2"
  }
}
