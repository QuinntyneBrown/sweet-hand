{
  "name": "sweet-hand-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "test": "node --import @swc-node/register/esm-register --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import @swc-node/register/esm-register src/platform/migrate.ts",
    "seed": "node --import @swc-node/register/esm-register src/seed/run.ts",
    "smoke:postgres": "node --import @swc-node/register/esm-register src/platform/postgres-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.2"
  }
}
