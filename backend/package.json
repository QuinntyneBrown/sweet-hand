{
  "name": "sweet-hand-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\"",
