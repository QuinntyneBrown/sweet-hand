@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Meet accessibility

Person(customer, "Customer", "Keyboard and screen reader user")
System_Ext(ci, "CI pipeline", "<TO SUPPLY>")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Pages, dialogs and forms built from accessible building blocks")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "Returns field-level validation errors")
}

Rel(customer, web, "Uses", "HTTPS")
Rel(web, api, "Submits forms, receives field errors", "JSON/HTTPS")
Rel(ci, web, "Runs acceptance suite with axe-core at XS and XL", "HTTPS")
@enduml
