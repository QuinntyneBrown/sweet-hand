@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Meet accessibility

Person(customer, "Customer", "Keyboard and screen reader user")
Container_Boundary(web, "Sweet Hand web application") {
  Component(page, "Page templates", "Page", "Every page, dialog and form")
  Component(skip, "SkipLink", "Page component", "First Tab target; jumps to main content")
  Component(dialog, "DialogHost", "Page component", "Wraps the UI framework dialog primitive")
  Component(focus, "FocusManager", "Page component", "Move in, trap, return focus")
  Component(field, "FormField", "Page component", "Visible label, aria-invalid, aria-describedby")
  Component(summary, "ErrorSummary", "Page component", "Linked list of errors; receives focus")
  Component(live, "LiveRegionAnnouncer", "Page component", "aria-live polite announcements")
  Component(visual, "Visual building blocks", "Page component", "IconButton, StatusIndicator, PhotoScrim, MotionPreference, focus and colour tokens")
}
Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Field errors")
Container_Boundary(ci, "CI pipeline") {
  Component(suite, "Acceptance suite", "Test suite", "Page objects drive each UI state")
  Component(check, "AccessibilityCheck", "axe-core", "WCAG 2.1 A and AA rules at XS and XL")
  Component(gate, "MergeGate", "Pipeline step", "Blocks merge on failure")
}

Rel(customer, page, "Uses", "HTTPS")
Rel(page, skip, "Renders first")
Rel(page, dialog, "Opens dialogs through")
Rel(dialog, focus, "Registers with")
Rel(page, field, "Composes forms from")
Rel(page, summary, "Shows errors in")
Rel(page, live, "Announces result counts through")
Rel(page, visual, "Uses")
Rel(page, api, "Submits forms", "JSON/HTTPS")
Rel(suite, page, "Drives")
Rel(suite, check, "Runs after each UI state")
Rel(gate, suite, "Reads result of")
@enduml
