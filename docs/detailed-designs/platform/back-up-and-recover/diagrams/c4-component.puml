@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Back up and recover

Person(ops, "Operations team", "Runs restores and drills")
Container_Boundary(iac, "Infrastructure-as-code definitions") {
  Component(dbpolicy, "DatabaseBackupPolicy", "Infrastructure as code", "PITR, 35 days, encrypted, secondary Canadian region")
  Component(storepolicy, "StorageProtectionPolicy", "Infrastructure as code", "Versioning or replication to secondary Canadian region")
}
Container_Boundary(runbooks, "Operations runbooks") {
  Component(runbook, "RestoreRunbook", "Runbook", "Restore to a point in time within 4 hours")
  Component(drill, "RestoreDrill", "Runbook", "Quarterly rehearsal in an isolated environment")
  Component(record, "RestoreDrillRecord", "Record", "Date, point, duration, data gap, result")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Primary")
ContainerDb(storage, "Object storage", "S3-compatible object storage", "Photos and certificates")
ContainerDb(dbbackup, "Database backups", "PostgreSQL point-in-time backups", "Secondary Canadian region")

Rel(dbpolicy, db, "Configures")
Rel(storepolicy, storage, "Configures")
Rel(db, dbbackup, "Ships backups")
Rel(ops, drill, "Runs quarterly")
Rel(drill, runbook, "Follows")
Rel(runbook, dbbackup, "Restores from")
Rel(drill, record, "Writes")
@enduml
