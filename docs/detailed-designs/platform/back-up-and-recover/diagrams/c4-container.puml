@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Back up and recover

Person(ops, "Operations team", "Runs restores and drills")
System_Boundary(sweethand, "Sweet Hand") {
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Writes profiles, enquiries and reviews")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Primary Canadian region; PITR enabled")
  ContainerDb(storage, "Object storage", "S3-compatible object storage", "Photos and certificate files; replicated")
}
System_Boundary(secondary, "Secondary Canadian region") {
  ContainerDb(dbbackup, "Database backups", "PostgreSQL point-in-time backups", "Encrypted; 35 days of point-in-time recovery")
  ContainerDb(replica, "Replicated object storage", "S3-compatible object storage", "Photo and certificate copies")
}
System_Ext(restore, "Isolated restore environment", "Canadian region")

Rel(api, db, "Writes")
Rel(api, storage, "Writes files")
Rel(db, dbbackup, "Ships logs and snapshots")
Rel(storage, replica, "Replicates")
Rel(ops, dbbackup, "Starts point-in-time restore")
Rel(dbbackup, restore, "Restores into")
@enduml
