@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deliver fast pages

Person(visitor, "Visitor", "Phone browser")
System_Ext(cdn, "CDN", "HTML cache of 60 s or less; photo delivery")
System_Ext(obs, "Observability platform", "Metrics")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages with cache headers and lazy images")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Stateless instances; listing, caterer page and enquiry endpoints")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Profiles, enquiries and sessions")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Notification jobs")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Sends email and processes photos")
  ContainerDb(storage, "Object storage", "S3-compatible object storage", "Processed photo derivatives")
}

Rel(visitor, cdn, "Requests", "HTTPS")
Rel(cdn, web, "Forwards cache misses for HTML", "HTTPS")
Rel(cdn, storage, "Fetches photo derivatives", "HTTPS")
Rel(web, api, "Reads page data", "JSON/HTTPS")
Rel(api, db, "Reads and writes")
Rel(api, queue, "Enqueues email asynchronously (L2-086 AC3)")
Rel(worker, queue, "Consumes jobs")
Rel(worker, storage, "Writes encoded derivatives")
Rel(api, obs, "Sends latency metrics and Web Vitals")
@enduml
