@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Monitor health

System_Ext(hosting, "Hosting platform", "<TO SUPPLY>")
System_Ext(obs, "Observability platform", "Holds AlertRules, UptimeCheck and MaintenanceWindow")
Person(ops, "Operations team", "On-call")
Container_Boundary(api, "Sweet Hand API") {
  Component(health, "HealthEndpoints", "Endpoint group", "/health/live and /health/ready")
  Component(ready, "ReadinessCheck", "Infrastructure", "Database connection with timeout")
  Component(corr, "CorrelationIdStep", "Request pipeline", "First RequestPipeline step; X-Correlation-ID")
  Component(endpoints, "Feature endpoints", "Endpoint group", "All other endpoints")
  Component(exc, "UnhandledExceptionHandler", "Request pipeline", "Last pipeline step; generic error with correlation ID")
  Component(tele, "TelemetryEmitter", "Infrastructure", "Structured logs, metrics, spans")
  Component(metrics, "MetricsRegistry", "Infrastructure", "Rate, errors, latency, queue depths")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Readiness dependency")

Rel(hosting, health, "Probes", "HTTPS")
Rel(health, ready, "Runs for /health/ready")
Rel(ready, db, "Checks connection")
Rel(corr, endpoints, "Passes request with correlation ID")
Rel(endpoints, exc, "Unhandled exceptions caught by")
Rel(corr, tele, "Attaches correlation ID to")
Rel(exc, tele, "Records stack trace through")
Rel(tele, metrics, "Uses definitions from")
Rel(tele, obs, "Exports")
Rel(obs, ops, "Alerts")
@enduml
