@startuml
title UML sequence behaviour — Load secrets at start-up
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Hosting platform" as hosting
box "Backend — Sweet Hand API application" #D1FADF
  participant "API instance" as app
  participant "HealthEndpoints" as health
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "RuntimeConfiguration" as config
  participant "SecretProvider" as provider
end box
participant "Managed secret store" as secrets
hosting -> app : Start instance from scanned image (non-root)
app -> config : Load non-secret settings and secret references
config --> app : Settings, no secret values
app -> provider : load(secret references)
provider -> secrets : Authenticate with workload identity <TO SUPPLY>
provider -> secrets : Read each referenced secret (L2-083 AC2)
alt all secrets returned
  secrets --> provider : Secret values held in memory only
  provider --> app : Loaded
  hosting -> health : GET /health/ready
  health --> hosting : 200
else secret store unreachable or access denied
  secrets --> provider : Error
  provider --> app : Startup failure, no secret logged
  hosting -> health : GET /health/ready
  health --> hosting : 503, instance receives no traffic
end
@enduml
