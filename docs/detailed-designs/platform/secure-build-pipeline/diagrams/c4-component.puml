@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Secure build pipeline

Person_Ext(contributor, "Contributor", "Opens pull requests")
System_Ext(repo, "Source repository", "<TO SUPPLY>")
System_Ext(registry, "Container registry", "<TO SUPPLY>")
System_Ext(secrets, "Managed secret store", "<TO SUPPLY>")
Container_Boundary(ci, "CI pipeline") {
  Component(secretscan, "SecretScanStep", "Pipeline step", "Credentials, API keys, private keys")
  Component(sca, "CompositionAnalysisStep", "Pipeline step", "Critical or High with fix fails")
  Component(imagescan, "ImageScanStep", "Pipeline step", "No Critical; non-root user")
  Component(region, "RegionPolicyCheckStep", "Pipeline step", "Personal-information resources in Canadian regions")
  Component(lint, "StringLiteralLintStep", "Pipeline step", "User-facing literals outside resource files")
  Component(gate, "PipelineGatePolicy", "Infrastructure as code", "Required steps block merge")
}
Container_Boundary(api, "Sweet Hand API (same pattern in web application and worker)") {
  Component(provider, "SecretProvider", "Infrastructure", "Loads secrets at start-up")
  Component(config, "RuntimeConfiguration", "Infrastructure", "Non-secret settings and secret references")
}

Rel(contributor, repo, "Pushes")
Rel(repo, secretscan, "Commit contents")
Rel(repo, sca, "Dependency manifests")
Rel(repo, region, "IaC definitions")
Rel(repo, lint, "Templates and components")
Rel(imagescan, registry, "Publishes passing images")
Rel(gate, secretscan, "Requires")
Rel(gate, sca, "Requires")
Rel(gate, imagescan, "Requires")
Rel(gate, region, "Requires")
Rel(gate, lint, "Requires")
Rel(config, provider, "Supplies secret references to")
Rel(provider, secrets, "Reads", "HTTPS")
@enduml
