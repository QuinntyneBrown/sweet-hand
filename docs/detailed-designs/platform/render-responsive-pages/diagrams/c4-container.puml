@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Render responsive pages

Person(customer, "Customer", "Uses a phone, tablet or desktop browser")
System_Ext(ci, "CI pipeline", "<TO SUPPLY>")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages, responsive layout, externalised text")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Profiles, enquiries, reviews and accounts")
}

Rel(customer, web, "Requests pages", "HTTPS")
Rel(web, api, "Reads page data through API client contracts", "JSON/HTTPS")
Rel(api, db, "Reads and writes")
Rel(ci, web, "Runs ResponsiveLayoutSuite against", "HTTPS")
@enduml
