@startuml
title UML sequence behaviour — Bot-protection provider unreachable
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Customer" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "Protected form" as page
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "Feature endpoints" as ep
  participant "RateLimitPolicy" as limits
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "Feature command handler" as handler
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "BotProtectionVerifier" as verifier
  participant "DependencyHealth" as health
end box
participant "Bot-protection provider" as bot
participant "Observability platform" as obs
actor -> page : Submit form with challenge token
page -> ep : HTTPS request
ep -> verifier : verify(token)
verifier -> bot : Verify token
bot --> verifier : Timeout or connection error
verifier -> health : recordFailure(BotProtection)
health -> obs : Raise degradation alert (L2-091 AC4)
verifier --> ep : ProviderUnavailable
ep -> limits : effectiveLimit(form)
limits -> health : stateOf(BotProtection)
health --> limits : Unavailable
limits --> ep : Half the normal threshold
alt client within halved limit
  ep -> handler : Process submission
  handler --> ep : Result
  ep --> page : Success
  page --> actor : Submission accepted
else client over halved limit
  ep --> page : 429 with Retry-After
  page --> actor : Try again later
end
@enduml
