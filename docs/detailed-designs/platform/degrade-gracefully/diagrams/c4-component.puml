@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Degrade gracefully

System_Ext(email, "Email provider", "Transactional email")
System_Ext(bot, "Bot-protection provider", "Challenge tokens")
System_Ext(obs, "Observability platform", "Alerts")
Container_Boundary(api, "Sweet Hand API") {
  Component(handlers, "Command handlers", "Command handlers", "SendEnquiryHandler, ReplyToEnquiryHandler, UploadPhotoHandler")
  Component(verifier, "BotProtectionVerifier", "Infrastructure", "Returns ProviderUnavailable on outage")
  Component(health, "DependencyHealth", "Infrastructure", "Tracks availability per dependency")
  Component(limits, "RateLimitPolicy", "Domain policy", "Halves thresholds in degraded mode")
  Component(alert, "DegradationAlert", "Infrastructure", "Raises on-call alert")
}
ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent jobs")
Container_Boundary(worker, "Sweet Hand background worker") {
  Component(notify, "SendNotificationJob", "Job", "Exponential backoff up to 24 hours")
  Component(photo, "ProcessPhotoJob", "Job", "Retries until processing recovers")
}

Rel(handlers, queue, "Enqueue jobs in the same unit of work")
Rel(handlers, verifier, "Verify token")
Rel(verifier, bot, "Verifies", "HTTPS")
Rel(verifier, health, "Reports outcome")
Rel(limits, health, "Reads state")
Rel(health, alert, "Triggers on change")
Rel(alert, obs, "Sends")
Rel(notify, queue, "Consumes")
Rel(photo, queue, "Consumes")
Rel(notify, email, "Sends", "HTTPS")
@enduml
