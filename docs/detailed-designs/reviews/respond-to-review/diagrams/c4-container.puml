@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Respond to a review

Person(caterer, "Caterer", "Person or small business selling Caribbean food")
System_Ext(email, "Email provider", "Sends transactional email")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Caterer reviews screen and response dialogs")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Response rules and persistence")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Reviews and responses")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Sends queued notifications")
}
Rel(caterer, web, "Manages responses", "HTTPS")
Rel(web, api, "Posts, edits, deletes response", "JSON/HTTPS")
Rel(api, db, "Reads and writes review and response", "Drizzle ORM (SQL)")
Rel(api, queue, "Enqueues SendNotificationJob", "pg-boss (SQL)")
Rel(worker, queue, "Dequeues jobs", "pg-boss (SQL)")
Rel(worker, email, "Sends email", "HTTPS")
@enduml
