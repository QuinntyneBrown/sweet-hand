@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Respond to a review

Person(caterer, "Caterer", "Person or small business selling Caribbean food")
Person(customer, "Customer", "Author of the review")
System(sweethand, "Sweet Hand", "Platform connecting Toronto and GTA customers with Caribbean caterers")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(caterer, sweethand, "Posts, edits and deletes review responses using", "HTTPS")
Rel(sweethand, email, "Sends response notification via", "<TO SUPPLY>")
Rel(email, customer, "Delivers response notification to", "Email")
@enduml
