@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit or delete a review

Person(customer, "Customer", "Author of a review")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Caterer page with edit and delete dialogs")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Author and edit-window rules")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Reviews, responses, rating summaries, review queue")
}
Rel(customer, web, "Edits or deletes review", "HTTPS")
Rel(web, api, "Sends edit or delete", "JSON/HTTPS")
Rel(api, db, "Updates or deletes review; recalculates summary", "Drizzle ORM (SQL)")
@enduml
