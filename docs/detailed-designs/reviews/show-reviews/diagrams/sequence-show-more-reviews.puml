@startuml
title UML sequence behaviour — Show more reviews
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "ShowMoreReviewsButton" as more
  participant "ReviewsSection" as section
  participant "ReviewsClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "PublicCaterersEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "GetCatererReviewsHandler" as handler
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "ReviewRepository" as revRepo
  database "Sweet Hand database" as db
end box
actor -> more : Activate Show more reviews
more -> client : getReviews(slug, next page)
client -> endpoints : GET caterer reviews page n
endpoints -> handler : Send GetCatererReviewsQuery
handler -> revRepo : ListPublished(offset 10 x (n - 1), limit 10)
revRepo -> db : Select published reviews, newest first
db --> revRepo : Up to 10 reviews
revRepo --> handler : Review page
handler -> handler : Format labels and event months
handler --> endpoints : CatererReviewsView with HasMore
endpoints --> client : 200
client --> section : Next 10 reviews
section -> section : Append without page reload (L2-051 AC4)
section -> section : Announce new shown count in polite live region (L2-067)
alt HasMore is false
  section -> more : Hide control
end
section --> actor : Additional reviews visible
@enduml
