@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Show reviews on the caterer page

Person(visitor, "Visitor", "Anyone browsing without signing in")
System_Ext(cdn, "CDN", "Caches public HTML for 60 seconds or less")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-renders the caterer page and its reviews section")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Public review pages and rating summary")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Caterer profiles, reviews, rating summaries")
}
Rel(visitor, cdn, "Requests caterer page", "HTTPS")
Rel(cdn, web, "Fetches uncached HTML", "HTTPS")
Rel(visitor, web, "Loads more reviews", "HTTPS")
Rel(web, api, "Reads summary and review pages", "JSON/HTTPS")
Rel(api, db, "Reads published reviews", "Drizzle ORM (SQL)")
@enduml
