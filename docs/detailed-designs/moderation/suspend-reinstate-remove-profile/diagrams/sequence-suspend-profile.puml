@startuml
title UML sequence behaviour — Suspend a profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "SuspendProfileDialog" as page
  participant "ModerationClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorProfilesEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "SuspendProfileHandler" as handler
  participant "CatererProfile" as entity
  participant "Enquiry" as enquiry
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  participant "JobQueue" as jobs
  database "Sweet Hand database" as db
end box
actor -> page : Enter reason and confirm suspension
page -> client : suspend(profileId, reason)
client -> endpoints : POST /operator/profiles/{id}/suspend (operator check in RequestPipeline)
endpoints -> handler : Send SuspendProfileCommand
handler -> db : Load profile and Open or Replied enquiries
db --> handler : CatererProfile, enquiries
handler -> entity : Suspend(reason, operatorId)
alt status is not Published
  entity --> handler : Invalid transition
  handler --> endpoints : Conflict
  endpoints --> client : 409 (L2-046)
else Published
  entity -> entity : Apply L2-046 transition to Suspended, record history
  entity --> handler : Suspended
  loop each Open or Replied enquiry
    handler -> enquiry : CloseBecauseCatererUnavailable() (L2-058 AC2)
    handler -> jobs : Enqueue customer email: caterer no longer available
  end
  handler -> audit : Append Suspend entry with status before and after (L2-060 AC1)
  handler -> jobs : Enqueue caterer email with reason (L2-058 AC1)
  handler -> db : Commit in one unit of work
  db --> handler : Committed
  handler --> endpoints : Success
  endpoints --> client : 200
  client --> page : Suspended
  page --> actor : Show Suspended; listing drops caterer within 60 s
end
@enduml
