@startuml
title UML sequence behaviour — Reinstate a profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "ReinstateProfileDialog" as page
  participant "ModerationClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorProfilesEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "ReinstateProfileHandler" as handler
  participant "CatererProfile" as entity
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  participant "JobQueue" as jobs
  database "Sweet Hand database" as db
end box
actor -> page : Enter reason and confirm reinstatement
page -> client : reinstate(profileId, reason)
client -> endpoints : POST /operator/profiles/{id}/reinstate
endpoints -> handler : Send ReinstateProfileCommand
handler -> db : Load profile
db --> handler : CatererProfile
handler -> entity : Reinstate(reason, operatorId)
alt status is not Suspended
  entity --> handler : Invalid transition
  handler --> endpoints : Conflict
  endpoints --> client : 409 (L2-046)
else Suspended
  entity -> entity : Apply L2-046 transition to Published, record history
  entity --> handler : Published
  handler -> audit : Append Reinstate entry
  handler -> jobs : Enqueue caterer email with reason
  handler -> db : Commit in one unit of work
  db --> handler : Committed
  handler --> endpoints : Success
  endpoints --> client : 200
  client --> page : Reinstated
  page --> actor : Caterer returns to listing within 60 s with earlier reviews (L2-058 AC3)
end
@enduml
