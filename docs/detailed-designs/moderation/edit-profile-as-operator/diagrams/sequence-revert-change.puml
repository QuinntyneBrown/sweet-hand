@startuml
title UML sequence behaviour — Revert a caterer edit
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "RevertChangeDialog" as page
  participant "ModerationClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorProfilesEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "RevertProfileEditHandler" as handler
  participant "ProfileEdit" as edit
  participant "CatererProfile" as entity
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  participant "JobQueue" as jobs
  database "Sweet Hand database" as db
end box
actor -> page : Activate Revert on a recent-changes entry
page --> actor : Show old and new values; ask for reason
actor -> page : Confirm revert
page -> client : revert(editId, reason)
client -> endpoints : POST /operator/recent-changes/{editId}/revert
endpoints -> handler : Send RevertProfileEditCommand
handler -> db : Load ProfileEdit and profile
db --> handler : ProfileEdit, CatererProfile
handler -> entity : ApplyOperatorEdit(field, edit.oldValue, reason) (L2-057 AC3)
entity --> handler : FieldChange
handler -> edit : MarkReverted(now)
handler -> audit : Append Revert entry with before, after and reason
handler -> jobs : Enqueue caterer email with reason
handler -> db : Commit in one unit of work
db --> handler : Committed
handler --> endpoints : Success
endpoints --> client : 200
client --> page : Reverted
page --> actor : Feed entry shows reverted
@enduml
