@startuml
title UML sequence behaviour — Deactivate an operator
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Admin operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "DeactivateOperatorDialog" as page
  participant "OperatorAccountsClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorAccountsEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "DeactivateOperatorAccountHandler" as handler
  participant "UserAccount" as account
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "SessionStore" as sessions
  participant "AuditLog" as audit
  database "Sweet Hand database" as db
end box
actor -> page : Confirm deactivation with reason
page -> client : deactivate(accountId, reason)
client -> endpoints : POST /operator/accounts/{id}/deactivate (AdminPolicy in RequestPipeline)
endpoints -> handler : Send DeactivateOperatorAccountCommand
handler -> db : Load account
db --> handler : UserAccount
handler -> account : Deactivate(now)
handler -> sessions : Revoke every session of the account
handler -> audit : Append DeactivateOperator entry with reason (L2-060)
handler -> db : Commit in one unit of work
db --> handler : Committed
handler --> endpoints : Success
endpoints --> client : 200
client --> page : Deactivated
page --> actor : Show deactivated
note over sessions : The next request on a revoked session fails;\nsession lookups are cached for no more than 60 s (L2-056 AC4)
@enduml
