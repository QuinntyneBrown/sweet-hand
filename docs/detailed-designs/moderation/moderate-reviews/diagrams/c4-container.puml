@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Moderate reviews

Person(operator, "Operator", "Sweet Hand team member who approves caterers and moderates content")
Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or event")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages and client interactions for visitors, customers, caterers and operators")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Runs queued and scheduled jobs")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Accounts, profiles, enquiries, reviews, reports, audit log")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
}
System_Ext(email, "Email provider", "Sends transactional email and reports bounces")

Rel(operator, web, "Moderates reviews", "HTTPS")
Rel(web, api, "Calls operator review endpoints", "JSON/HTTPS")
Rel(api, db, "Writes review status, summary, audit entry")
Rel(api, queue, "Enqueues author email")
Rel(worker, queue, "Consumes jobs")
Rel(worker, email, "Sends email", "HTTPS")
Rel(email, customer, "Delivers email")
@enduml
