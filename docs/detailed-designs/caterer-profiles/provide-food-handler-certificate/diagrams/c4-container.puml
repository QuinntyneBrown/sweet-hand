@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Provide a food handler certificate

Person(caterer, "Caterer", "Provides certificate")
Person(operator, "Operator", "Reviews certificate")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Certificate section of the profile editor")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Certificate endpoints and rules")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Daily maintenance job and notifications")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Certificate details, reminder log, review queue")
  ContainerDb(storage, "Object storage", "S3-compatible object storage", "Private certificate files (Canadian region)")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
}
System_Ext(malware, "Malware scanning service", "Scans uploaded files")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(caterer, web, "Enters details and uploads file", "HTTPS")
Rel(operator, web, "Views certificate", "HTTPS")
Rel(web, api, "Calls certificate endpoints", "JSON/HTTPS")
Rel(api, malware, "Scans file", "HTTPS")
Rel(api, db, "Reads and writes certificate details", "Drizzle ORM (SQL)")
Rel(api, storage, "Stores file, issues time-limited URL", "S3 API/HTTPS")
Rel(worker, db, "Finds expiring and expired certificates", "Drizzle ORM (SQL)")
Rel(worker, queue, "Enqueues and takes reminder jobs")
Rel(worker, email, "Sends reminders via", "HTTPS")
@enduml
