@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Provide a food handler certificate

Person(caterer, "Caterer", "Provides certificate")
Person(operator, "Operator", "Reviews certificate")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Certificate section of the profile editor")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "Certificate endpoints and rules")
  Container(worker, "Sweet Hand background worker", "<TO SUPPLY>", "Daily maintenance job and notifications")
  ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Certificate details, reminder log, review queue")
  ContainerDb(storage, "Object storage", "<TO SUPPLY>", "Private certificate files (Canadian region)")
  ContainerQueue(queue, "Job queue", "<TO SUPPLY>", "Persistent queue of background jobs")
}
System_Ext(malware, "Malware scanning service", "Scans uploaded files")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(caterer, web, "Enters details and uploads file", "HTTPS")
Rel(operator, web, "Views certificate", "HTTPS")
Rel(web, api, "Calls certificate endpoints", "JSON/HTTPS")
Rel(api, malware, "Scans file", "<TO SUPPLY>")
Rel(api, db, "Reads and writes certificate details", "<TO SUPPLY>")
Rel(api, storage, "Stores file, issues time-limited URL", "<TO SUPPLY>")
Rel(worker, db, "Finds expiring and expired certificates", "<TO SUPPLY>")
Rel(worker, queue, "Enqueues and takes reminder jobs")
Rel(worker, email, "Sends reminders via", "<TO SUPPLY>")
@enduml
