@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage the menu

Person(caterer, "Caterer", "Manages dishes")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Menu manager and dish dialog")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Menu endpoints and menu rules")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Menu items")
}

Rel(caterer, web, "Edits dishes", "HTTPS")
Rel(web, api, "Calls menu endpoints", "JSON/HTTPS")
Rel(api, db, "Reads and writes menu items", "Drizzle ORM (SQL)")
@enduml
