@startuml
title UML sequence behaviour — Add or edit a dish
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Caterer" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "MenuManagerPage" as page
  participant "MenuItemDialog" as dialog
  participant "MenuClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "CatererMenuEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "AddMenuItemHandler" as handler
  participant "CatererProfile" as profile
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "CatererProfileRepository" as repo
  database "Sweet Hand database" as db
end box

actor -> page : Activate "Add dish"
page -> dialog : Open (focus moves into dialog)
actor -> dialog : Enter "Pepperpot", description, tags, price guidance, position
dialog -> client : add(item, position)
client -> endpoints : POST /caterer/profile/menu-items
endpoints -> endpoints : Schema check — unknown dietary tag gives HTTP 400 (L2-017 AC3)
endpoints -> handler : Send AddMenuItemCommand (session caterer)
handler -> repo : GetByOwner(accountId)
repo -> db : Load
db --> repo : Profile with menu
repo --> handler : CatererProfile
handler -> profile : AddMenuItem(fields, position)
alt profile already has 50 dishes
  profile --> handler : "You can list up to 50 dishes" (L2-043 AC3)
  handler --> endpoints : Rejected
  endpoints --> client : HTTP 400
  client --> dialog : Message shown
else name under 2 or over 80 characters, or other length exceeded
  profile --> handler : Field length error (L2-043 AC4)
  handler --> endpoints : Rejected, nothing stored
  endpoints --> client : HTTP 400 with field errors
  client --> dialog : Inline errors linked to fields (L2-068)
else valid
  profile --> handler : MenuItem at chosen position (L2-043 AC1)
  handler -> repo : Save(profile)
  repo -> db : Commit
  handler --> endpoints : MenuItemView
  endpoints --> client : HTTP 201
  client --> dialog : Saved
  dialog --> page : Close, focus returns to "Add dish"
  page --> actor : Menu shows the new dish in position
end
note over handler
  Editing follows the same path through
  UpdateMenuItemHandler and PUT /caterer/profile/menu-items/{id}.
end note
@enduml
