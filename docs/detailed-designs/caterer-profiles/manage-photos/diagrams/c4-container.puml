@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage photos

Person(caterer, "Caterer", "Manages photos")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Photo manager and photo details dialog")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Upload checks and photo rules")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "ProcessPhotoJob entries")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Malware scan and image processing")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Photo records and order")
  ContainerDb(storage, "Object storage", "S3-compatible object storage", "Private originals, public derivatives")
}
System_Ext(malware, "Malware scanning service", "Scans uploaded files")
System_Ext(cdn, "CDN", "Serves derivatives")

Rel(caterer, web, "Uploads and arranges photos", "HTTPS")
Rel(web, api, "Calls photo endpoints", "JSON and multipart/HTTPS")
Rel(api, storage, "Writes originals to private area", "S3 API/HTTPS")
Rel(api, db, "Writes photo records", "Drizzle ORM (SQL)")
Rel(api, queue, "Enqueues ProcessPhotoJob")
Rel(worker, queue, "Takes jobs from")
Rel(worker, malware, "Scans original", "HTTPS")
Rel(worker, storage, "Reads originals, writes derivatives", "S3 API/HTTPS")
Rel(worker, db, "Updates processing state", "Drizzle ORM (SQL)")
Rel(worker, cdn, "Purges replaced images", "HTTPS")
Rel(cdn, storage, "Fetches public derivatives from", "HTTPS")
@enduml
