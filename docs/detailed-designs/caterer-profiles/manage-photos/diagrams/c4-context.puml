@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Manage photos

Person(caterer, "Caterer", "Uploads, captions, orders and replaces photos")
Person(visitor, "Visitor", "Sees processed photos on the listing and caterer page")
System(sweethand, "Sweet Hand", "Platform connecting Toronto and GTA customers with Caribbean caterers")
System_Ext(malware, "Malware scanning service", "Scans uploaded files")
System_Ext(cdn, "CDN", "Serves processed photos and caches public pages")

Rel(caterer, sweethand, "Manages photos using", "HTTPS")
Rel(sweethand, malware, "Scans each upload with", "<TO SUPPLY>")
Rel(sweethand, cdn, "Publishes derivatives and purges stale content through", "<TO SUPPLY>")
Rel(visitor, cdn, "Loads photos from", "HTTPS")
@enduml
