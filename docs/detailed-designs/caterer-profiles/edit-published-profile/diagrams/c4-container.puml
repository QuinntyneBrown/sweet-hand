@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit a published profile

Person(caterer, "Caterer", "Edits published profile")
Person(operator, "Operator", "Approves name changes")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Profile editor and operator review queue")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Live edits, name change workflow, slug rules")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Profiles, change records, queue items, slug redirects, audit log")
}
System_Ext(cdn, "CDN", "Caches public HTML")

Rel(caterer, web, "Edits sections, requests name change", "HTTPS")
Rel(operator, web, "Approves name change", "HTTPS")
Rel(web, api, "Calls profile and operator endpoints", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "Drizzle ORM (SQL)")
Rel(api, cdn, "Purges changed public paths", "HTTPS")
Rel(cdn, web, "Fetches public pages from", "HTTPS")
@enduml
