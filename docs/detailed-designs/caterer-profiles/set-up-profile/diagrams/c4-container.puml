@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Set up a caterer profile

Person(caterer, "Caterer", "Builds their profile")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Profile editor, setup checklist, listing card preview")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Profile endpoints, section rules, checklist rules")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Draft profiles, cuisines, regions and service areas")
}

Rel(caterer, web, "Edits sections", "HTTPS")
Rel(web, api, "Loads profile, saves sections", "JSON/HTTPS")
Rel(api, db, "Reads reference data, reads and writes draft", "Drizzle ORM (SQL)")
@enduml
