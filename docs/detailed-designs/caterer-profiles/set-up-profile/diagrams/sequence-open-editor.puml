@startuml
title UML sequence behaviour — Open the editor and show the checklist
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Caterer" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "ProfileEditorPage" as page
  participant "SetupChecklist" as checklist
  participant "CatererProfileClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "RequestPipeline" as pipeline
  participant "CatererProfileEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "GetOwnProfileHandler" as handler
  participant "ProfileSubmissionRules" as rules
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "CatererProfileRepository" as repo
  database "Sweet Hand database" as db
end box

actor -> page : Open profile editor (any device)
page -> client : getOwnProfile() and getReferenceData()
client -> pipeline : GET /caterer/profile
pipeline -> pipeline : Authenticate session, require Caterer role
pipeline -> endpoints : Authorised request
endpoints -> handler : Send GetOwnProfileQuery for session account
handler -> repo : GetByOwner(accountId)
repo -> db : Load profile and selections
db --> repo : Saved draft values (L2-038 AC2)
repo --> handler : CatererProfile
handler -> rules : Evaluate L2-039 rules
rules --> handler : SetupChecklist
handler --> endpoints : OwnProfileView with status and checklist
endpoints --> client : HTTP 200
client --> page : Profile, checklist, reference data
alt status is Pending review or Suspended
  page --> actor : Read-only editor with reason or Withdraw control
else status is Draft or Changes requested
  alt viewport XS or SM
    page --> actor : Stacked section list, one section open (L2-045 AC2)
  else viewport LG
    page --> actor : Sidebar navigation and main section, no card preview (L2-045 AC3)
  else viewport XL
    page --> actor : Sidebar navigation, main section, live card preview (L2-045 AC3, AC4)
  end
  page -> checklist : Render items
  checklist --> actor : Each rule shown as done or not done (L2-038 AC3)
end
@enduml
