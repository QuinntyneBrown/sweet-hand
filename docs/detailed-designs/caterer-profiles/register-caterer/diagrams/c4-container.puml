@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Register a caterer

Person(caterer, "Caterer", "Registers a caterer account")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages and client interactions")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Accounts, profiles, consent records, token hashes")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Sends queued notifications")
}
System_Ext(bot, "Bot-protection provider", "Verifies challenge tokens")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(caterer, web, "Fills in registration form", "HTTPS")
Rel(web, api, "Submits registration", "JSON/HTTPS")
Rel(api, bot, "Verifies challenge token", "HTTPS")
Rel(api, db, "Writes account, draft profile and consent", "Drizzle ORM (SQL)")
Rel(api, queue, "Enqueues verification email job")
Rel(worker, queue, "Takes jobs from")
Rel(worker, email, "Sends email via", "HTTPS")
@enduml
