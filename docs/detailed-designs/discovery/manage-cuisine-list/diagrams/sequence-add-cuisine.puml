@startuml
title UML sequence behaviour — Add a cuisine
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "CuisineListScreen" as screen
  participant "AddCuisineDialog" as dialog
  participant "CuisinesAdminClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorCuisinesEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "AddCuisineHandler" as handler
  participant "Cuisine" as entity
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "CuisineRepository" as repo
  participant "AuditLog" as audit
  database "Sweet Hand database" as db
end box
actor -> screen : Activate "Add cuisine"
screen -> dialog : Open dialog
actor -> dialog : Enter "Caymanian" and submit
dialog -> client : Add cuisine
client -> endpoints : POST /api/operator/cuisines
endpoints -> endpoints : Authenticate; require operator role on server
endpoints -> handler : Send AddCuisineCommand
handler -> repo : Find by slug "caymanian"
repo -> db : Query
db --> repo : None
repo --> handler : Not found
handler -> entity : Create("Caymanian")
entity --> handler : Active cuisine
handler -> repo : Save cuisine
handler -> audit : Append operator action
repo -> db : Insert in one unit of work
audit -> db : Append in same unit of work
db --> handler : Commit result
handler --> endpoints : Created cuisine id
endpoints --> client : HTTP 201
client --> dialog : Success
dialog --> screen : Close; focus returns to "Add cuisine"
screen --> actor : "Caymanian" listed as active; selectable and offered as filter (L2-007 AC4)
@enduml
