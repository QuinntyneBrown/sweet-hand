@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Filter the listing by cuisine

Person(visitor, "Visitor", "Browses caterers without signing in")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Filter controls, chips and in-place result updates")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Filter matching and facet counts")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Caterer profiles and cuisine catalogue")
}
Rel(visitor, web, "Selects cuisines", "HTTPS")
Rel(web, api, "GET /api/public/caterers?cuisine=…", "JSON/HTTPS")
Rel(api, db, "Reads matching caterers and grouped counts")
@enduml
