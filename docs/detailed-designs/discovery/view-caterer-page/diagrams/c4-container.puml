@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a caterer page

Person(visitor, "Visitor", "Reads caterer pages")
System_Ext(cdn, "CDN", "Caches public HTML and serves processed photos")
System_Ext(search, "Search engines", "Crawl pages and sitemap")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-renders the caterer page and metadata")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "Public caterer view, slug and status rules, sitemap")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Approved profile values, slugs, redirects")
  ContainerDb(storage, "Object storage", "S3-compatible object storage", "Processed photo derivatives")
}
Rel(visitor, cdn, "Uses", "HTTPS")
Rel(search, cdn, "Crawls", "HTTPS")
Rel(cdn, web, "Fetches page HTML and sitemap", "HTTPS")
Rel(cdn, storage, "Fetches photo derivatives", "HTTPS")
Rel(web, api, "GET /api/public/caterers/{slug}", "JSON/HTTPS")
Rel(api, db, "Reads approved profile values")
@enduml
