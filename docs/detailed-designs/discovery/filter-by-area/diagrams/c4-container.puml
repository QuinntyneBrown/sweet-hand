@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Filter the listing by area

Person(visitor, "Visitor", "Browses caterers without signing in")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Area combobox, suggestions and chips")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "Service area model and area matching")
  ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Regions, service areas, caterer selections")
}
Rel(visitor, web, "Types and selects areas", "HTTPS")
Rel(web, api, "GET /api/public/service-areas; GET /api/public/caterers?area=…", "JSON/HTTPS")
Rel(api, db, "Reads areas and matching caterers")
@enduml
