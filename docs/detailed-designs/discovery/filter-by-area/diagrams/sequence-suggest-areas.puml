@startuml
title UML sequence behaviour — Suggest areas as the visitor types
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Visitor" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "AreaFilter" as area
  participant "ServiceAreasClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "PublicCaterersEndpoints" as endpoints
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "ServiceAreaRepository" as repo
  database "Sweet Hand database" as db
end box
area -> client : Load regions and areas (once per page)
client -> endpoints : GET /api/public/service-areas
endpoints -> repo : List regions with areas
repo -> db : Query
db --> repo : 5 regions, 30 areas (L2-010)
repo --> endpoints : Regions with areas
endpoints --> client : HTTP 200 JSON
client --> area : Area model cached in page
actor -> area : Type "scar"
area -> area : Normalise text and names (case, accents); substring match (L2-011 AC3)
alt one or more matches
  area --> actor : Suggest "Scarborough"
else no match
  area --> actor : "No matching areas"; active filters unchanged (L2-011 AC4)
end
@enduml
