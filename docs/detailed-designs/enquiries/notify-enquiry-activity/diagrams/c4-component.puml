@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Notify enquiry activity

Container_Boundary(api, "Sweet Hand API") {
  Component(handlers, "SendEnquiryHandler, PostReplyHandler, DeclineEnquiryHandler", "<TO SUPPLY>", "Actions that need an email")
  Component(sched, "NotificationScheduler", "<TO SUPPLY>", "Creates or extends Notification")
  Component(bounceep, "EmailEventsEndpoints", "<TO SUPPLY>", "Bounce webhook")
  Component(bounce, "HandleEmailBounceHandler", "<TO SUPPLY>", "Marks email undeliverable")
  Component(repo, "NotificationRepository", "<TO SUPPLY>", "Notification persistence")
}
Container_Boundary(worker, "Sweet Hand background worker") {
  Component(job, "SendNotificationJob", "<TO SUPPLY>", "Sends one notification")
  Component(composer, "NotificationComposer", "<TO SUPPLY>", "Builds email from templates")
  Component(retry, "RetryPolicy", "<TO SUPPLY>", "Exponential backoff, 24 h limit")
  Component(gateway, "EmailGateway", "<TO SUPPLY>", "Authenticated sending domain")
  Component(alert, "OperatorAlert", "<TO SUPPLY>", "Failed-notification alert")
}
ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Notifications and accounts")
ContainerQueue(queue, "Job queue", "<TO SUPPLY>", "Persistent jobs")
System_Ext(email, "Email provider", "Sends transactional email and reports bounces")
System_Ext(obs, "Observability platform", "Raises alerts")

Rel(handlers, sched, "Queue notification")
Rel(sched, repo, "Saves Notification with")
Rel(repo, db, "Reads and writes")
Rel(sched, queue, "Enqueues job after commit")
Rel(job, queue, "Takes job from")
Rel(job, db, "Loads and updates Notification")
Rel(job, composer, "Composes with")
Rel(job, gateway, "Sends with")
Rel(job, retry, "Schedules retry with")
Rel(job, alert, "Raises alert with")
Rel(gateway, email, "Calls", "HTTPS")
Rel(alert, obs, "Sends alert to")
Rel(email, bounceep, "Posts bounce event", "Webhook")
Rel(bounceep, bounce, "Sends HandleEmailBounceCommand")
Rel(bounce, db, "Sets emailUndeliverable")
@enduml
