@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Notify enquiry activity

Container_Boundary(api, "Sweet Hand API") {
  Component(handlers, "SendEnquiryHandler, PostReplyHandler, DeclineEnquiryHandler", "Command handlers", "Actions that need an email")
  Component(sched, "NotificationScheduler", "Domain service", "Creates or extends Notification")
  Component(bounceep, "EmailEventsEndpoints", "Endpoint group", "Bounce webhook")
  Component(bounce, "HandleEmailBounceHandler", "Command handler", "Marks email undeliverable")
  Component(repo, "NotificationRepository", "Repository", "Notification persistence")
}
Container_Boundary(worker, "Sweet Hand background worker") {
  Component(job, "SendNotificationJob", "Job", "Sends one notification")
  Component(composer, "NotificationComposer", "Domain service", "Builds email from templates")
  Component(retry, "RetryPolicy", "Infrastructure", "Exponential backoff, 24 h limit")
  Component(gateway, "EmailGateway", "Infrastructure", "Authenticated sending domain")
  Component(alert, "OperatorAlert", "Infrastructure", "Failed-notification alert")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Notifications and accounts")
ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent jobs")
System_Ext(email, "Email provider", "Sends transactional email and reports bounces")
System_Ext(obs, "Observability platform", "Raises alerts")

Rel(handlers, sched, "Queue notification")
Rel(sched, repo, "Saves Notification with")
Rel(repo, db, "Reads and writes")
Rel(sched, queue, "Enqueues job after commit")
Rel(job, queue, "Takes job from")
Rel(job, db, "Loads and updates Notification")
Rel(job, composer, "Composes with")
Rel(job, gateway, "Sends with")
Rel(job, retry, "Schedules retry with")
Rel(job, alert, "Raises alert with")
Rel(gateway, email, "Calls", "HTTPS")
Rel(alert, obs, "Sends alert to")
Rel(email, bounceep, "Posts bounce event", "Webhook")
Rel(bounceep, bounce, "Sends HandleEmailBounceCommand")
Rel(bounce, db, "Sets emailUndeliverable")
@enduml
