@startuml
title UML sequence behaviour — Handle a permanent bounce
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Customer" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "UndeliverableEmailBanner" as banner
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "EmailEventsEndpoints" as ep
  participant "SessionsEndpoints" as signin
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "HandleEmailBounceHandler" as handler
  participant "UserAccount" as account
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
end box
participant "Email provider" as provider
provider -> ep : Bounce event (webhook)
ep -> ep : Authenticate webhook (scheme <TO SUPPLY>)
alt permanent bounce
  ep -> handler : Send HandleEmailBounceCommand
  handler -> db : Load account by email
  db --> handler : UserAccount
  handler -> account : MarkEmailUndeliverable() (L2-030 AC3)
  handler -> db : Save
else temporary failure
  ep -> ep : Ignore; retries follow RetryPolicy
end
actor -> signin : Sign in
signin --> banner : Session with emailUndeliverable = true
banner --> actor : Banner asking to update email address
@enduml
