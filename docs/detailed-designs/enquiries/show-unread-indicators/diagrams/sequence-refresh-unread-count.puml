@startuml
title UML sequence behaviour — Refresh the unread count
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Caterer" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "UnreadBadge" as badge
  participant "UnreadCountPoller" as poller
  participant "EnquiriesClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "EnquiriesEndpoints" as ep
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "GetUnreadCountHandler" as handler
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "EnquiryRepository" as repo
  database "Sweet Hand database" as db
end box
actor -> badge : Load any page while signed in
badge -> poller : Start
loop on page load, then every 60 s or less while tab is visible (L2-029 AC3)
  poller -> client : getUnreadCount()
  client -> ep : GET /enquiries/unread-count
  ep -> ep : Authenticate; require Customer or Caterer
  ep -> handler : Send GetUnreadCountQuery
  handler -> repo : CountUnreadFor(accountId, role)
  repo -> db : Count enquiries where other party's last activity > LastReadAt or no marker
  db --> repo : n
  repo --> handler : n
  handler --> ep : n
  ep --> client : { count: n }
  client --> poller : n
  poller --> badge : n
  alt n > 0
    badge --> actor : Badge "n", accessible name "n unread enquiries" (L2-029 AC1)
  else n = 0
    badge --> actor : No badge (L2-029 AC4)
  end
end
@enduml
