@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show unread indicators

Container_Boundary(web, "Sweet Hand web application") {
  Component(header, "SiteHeader", "Page component", "Shared header")
  Component(badge, "UnreadBadge", "Page component", "Visible count, hidden from assistive tech; names the link 'Enquiries, n unread'")
  Component(poller, "UnreadCountPoller", "Infrastructure", "Refreshes count")
  Component(row, "InboxRow", "Page component", "Highlights unread threads")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "unread-count, thread")
  Component(count, "GetUnreadCountHandler", "Query handler", "Counts unread threads")
  Component(mark, "MarkThreadReadHandler", "Command handler", "Moves read marker")
  Component(repo, "EnquiryRepository", "Repository", "CountUnreadFor")
  Component(readrepo, "ThreadReadStateRepository", "Repository", "Read markers")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries and read markers")

Rel(header, badge, "Renders")
Rel(badge, poller, "Gets count from")
Rel(poller, client, "Calls getUnreadCount")
Rel(client, ep, "GET /enquiries/unread-count", "JSON/HTTPS")
Rel(ep, count, "Sends GetUnreadCountQuery")
Rel(ep, mark, "Sends MarkThreadReadCommand on thread open")
Rel(count, repo, "Counts with")
Rel(mark, readrepo, "Saves with")
Rel(repo, db, "Queries")
Rel(readrepo, db, "Writes")
Rel(row, client, "Reads unread state through inbox list")
@enduml
