@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Show unread indicators

Container_Boundary(web, "Sweet Hand web application") {
  Component(header, "SiteHeader", "<TO SUPPLY>", "Shared header")
  Component(badge, "UnreadBadge", "<TO SUPPLY>", "Visible count, hidden from assistive tech; names the link 'Enquiries, n unread'")
  Component(poller, "UnreadCountPoller", "<TO SUPPLY>", "Refreshes count")
  Component(row, "InboxRow", "<TO SUPPLY>", "Highlights unread threads")
  Component(client, "EnquiriesClient", "<TO SUPPLY>", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(ep, "EnquiriesEndpoints", "<TO SUPPLY>", "unread-count, thread")
  Component(count, "GetUnreadCountHandler", "<TO SUPPLY>", "Counts unread threads")
  Component(mark, "MarkThreadReadHandler", "<TO SUPPLY>", "Moves read marker")
  Component(repo, "EnquiryRepository", "<TO SUPPLY>", "CountUnreadFor")
  Component(readrepo, "ThreadReadStateRepository", "<TO SUPPLY>", "Read markers")
}
ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Enquiries and read markers")

Rel(header, badge, "Renders")
Rel(badge, poller, "Gets count from")
Rel(poller, client, "Calls getUnreadCount")
Rel(client, ep, "GET /enquiries/unread-count", "JSON/HTTPS")
Rel(ep, count, "Sends GetUnreadCountQuery")
Rel(ep, mark, "Sends MarkThreadReadCommand on thread open")
Rel(count, repo, "Counts with")
Rel(mark, readrepo, "Saves with")
Rel(repo, db, "Queries")
Rel(readrepo, db, "Writes")
Rel(row, client, "Reads unread state through inbox list")
@enduml
