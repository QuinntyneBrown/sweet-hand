@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Reply in a thread

Container_Boundary(web, "Sweet Hand web application") {
  Component(pane, "ThreadPane", "Page component", "Thread view")
  Component(list, "ThreadMessageList", "Page component", "Literal text, Toronto timestamps")
  Component(reply, "ReplyBox", "Page component", "1-2,000 characters; fixed on XS")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "Thread and reply endpoints")
  Component(opep, "OperatorEnquiriesEndpoints", "Endpoint group", "Report-linked access")
  Component(policy, "EnquiryAccessPolicy", "Domain policy", "Party or linked-report check")
  Component(get, "GetThreadHandler", "Query handler", "Thread view")
  Component(post, "PostReplyHandler", "Command handler", "Adds a reply")
  Component(opget, "GetThreadForReportHandler", "Query handler", "Audited operator read")
  Component(agg, "Enquiry", "Domain aggregate", "Aggregate; AddMessage rules")
  Component(sched, "NotificationScheduler", "Domain service", "Queues new-message email")
  Component(audit, "AuditLog", "Infrastructure", "Append-only")
  Component(repo, "EnquiryRepository", "Repository", "Enquiries and messages")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries, messages, reports, audit log")

Rel(pane, list, "Renders")
Rel(pane, reply, "Renders when open")
Rel(pane, client, "Calls")
Rel(client, ep, "Calls", "JSON/HTTPS")
Rel(client, opep, "Calls (operator)", "JSON/HTTPS")
Rel(ep, get, "Sends GetThreadQuery")
Rel(ep, post, "Sends PostReplyCommand")
Rel(opep, opget, "Sends GetThreadForReportQuery")
Rel(get, policy, "Checks access")
Rel(post, policy, "Checks access")
Rel(opget, policy, "Checks report link")
Rel(post, agg, "AddMessage")
Rel(post, sched, "Queues notification")
Rel(opget, audit, "Writes access entry")
Rel(get, repo, "Loads with")
Rel(post, repo, "Saves with")
Rel(repo, db, "Reads and writes")
Rel(audit, db, "Appends")
@enduml
