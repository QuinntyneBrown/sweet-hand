@startuml
title UML sequence behaviour — Operator opens an enquiry for a report
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "ReportDetailPage" as page
  participant "OperatorReportsClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "OperatorEnquiriesEndpoints" as ep
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "GetThreadForReportHandler" as handler
  participant "EnquiryAccessPolicy" as policy
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "AuditLog" as audit
  database "Sweet Hand database" as db
end box
actor -> page : Open linked enquiry while handling report
page -> client : getEnquiryForReport(reportId, enquiryId, reason)
client -> ep : GET /operator/reports/{reportId}/enquiries/{id}
ep -> ep : Authenticate; require Operator role and second factor
ep -> handler : Send GetThreadForReportQuery
handler -> db : Load report and enquiry
db --> handler : Report, enquiry
handler -> policy : ForOperator(caller, enquiry, report)
alt no open report linked to this enquiry (L2-034 AC4)
  policy --> handler : Forbidden
  handler --> ep : Forbidden
  ep --> client : 403
else linked report
  policy --> handler : Allowed
  handler -> audit : Append operator, enquiry id, report id, time, reason (L2-034 AC3, L2-060)
  audit -> db : Insert AuditEntry
  handler --> ep : ThreadView (read-only)
  ep --> client : 200
  client --> page : Thread
  page --> actor : Read-only thread
end
@enduml
