@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reply in a thread

Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or an event")
Person(caterer, "Caterer", "Person or small business selling Caribbean food")
Person(operator, "Operator", "Sweet Hand team member who moderates the platform")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Server-rendered pages and client interactions for visitors, customers, caterers and operators")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Accounts, profiles, enquiries, messages, notifications, audit log")
  ContainerQueue(queue, "Job queue", "<TO SUPPLY>", "Persistent queue of background jobs")
}

Rel(customer, web, "Opens thread, replies", "HTTPS")
Rel(caterer, web, "Opens thread, replies", "HTTPS")
Rel(operator, web, "Opens thread from a report", "HTTPS")
Rel(web, api, "GET /enquiries/{id}; POST /enquiries/{id}/messages", "JSON/HTTPS")
Rel(api, db, "Reads thread; writes messages, audit entries, notifications")
Rel(api, queue, "Enqueues notification job")
@enduml
