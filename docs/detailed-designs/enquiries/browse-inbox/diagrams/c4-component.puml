@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Browse the inbox

Container_Boundary(web, "Sweet Hand web application") {
  Component(page, "InboxPage", "Page", "Route /inbox; state in URL")
  Component(layout, "InboxLayout", "Page component", "Side by side on LG-XL; stacked on XS-MD")
  Component(list, "InboxList", "Page component", "Rows and pagination")
  Component(filter, "InboxStatusFilter", "Page component", "Status filter")
  Component(pane, "ThreadPane", "Page component", "Thread view (reply-in-thread)")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "GET /enquiries")
  Component(handler, "GetInboxHandler", "Query handler", "Caller-scoped inbox page")
  Component(repo, "EnquiryRepository", "Repository", "ListForParty")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries and read markers")

Rel(page, layout, "Renders")
Rel(layout, list, "Shows")
Rel(layout, pane, "Shows beside list or full width")
Rel(page, filter, "Shows")
Rel(page, client, "Calls listInbox")
Rel(client, ep, "Calls", "JSON/HTTPS")
Rel(ep, handler, "Sends GetInboxQuery")
Rel(handler, repo, "Reads page with")
Rel(repo, db, "Queries")
@enduml
