@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse the inbox

Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or an event")
Person(caterer, "Caterer", "Person or small business selling Caribbean food")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages and client interactions for visitors, customers, caterers and operators")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Accounts, profiles, enquiries, messages, notifications, audit log")
}

Rel(customer, web, "Opens inbox", "HTTPS")
Rel(caterer, web, "Opens inbox", "HTTPS")
Rel(web, api, "GET /enquiries?status&page", "JSON/HTTPS")
Rel(api, db, "Reads enquiries the caller is party to")
@enduml
