@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Share contact details

Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or an event")
Person(caterer, "Caterer", "Person or small business selling Caribbean food")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Server-rendered pages and client interactions for visitors, customers, caterers and operators")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Accounts, profiles, enquiries, messages, notifications, audit log")
}

Rel(customer, web, "Shares contact details; views thread", "HTTPS")
Rel(caterer, web, "Shares contact details; views thread", "HTTPS")
Rel(web, api, "POST /enquiries/{id}/contact-shares; GET /enquiries/{id}", "JSON/HTTPS")
Rel(api, db, "Writes contact shares; reads accounts")
@enduml
