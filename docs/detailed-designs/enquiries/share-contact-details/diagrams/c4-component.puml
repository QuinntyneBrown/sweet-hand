@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Share contact details

Container_Boundary(web, "Sweet Hand web application") {
  Component(pane, "ThreadPane", "Page component", "Share action and shared details")
  Component(dialog, "ShareContactDialog", "Dialog", "Confirmation")
  Component(card, "SharedContactCard", "Page component", "Other party's email and phone")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "contact-shares and thread endpoints")
  Component(policy, "EnquiryAccessPolicy", "Domain policy", "Party check")
  Component(share, "ShareContactDetailsHandler", "Command handler", "Records a share")
  Component(get, "GetThreadHandler", "Query handler", "Reveals details only when shared")
  Component(agg, "Enquiry", "Domain aggregate", "ShareContact")
  Component(repo, "EnquiryRepository", "Repository", "Enquiries and shares")
  Component(accounts, "UserAccountRepository", "Repository", "Current email and phone")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries, shares, accounts")

Rel(pane, dialog, "Opens")
Rel(pane, card, "Renders when other party shared")
Rel(dialog, client, "shareContactDetails")
Rel(pane, client, "getThread")
Rel(client, ep, "Calls", "JSON/HTTPS")
Rel(ep, share, "Sends ShareContactDetailsCommand")
Rel(ep, get, "Sends GetThreadQuery")
Rel(share, policy, "Checks party")
Rel(get, policy, "Checks party")
Rel(share, agg, "ShareContact")
Rel(share, repo, "Saves with")
Rel(get, repo, "Loads with")
Rel(get, accounts, "Reads shared details from")
Rel(repo, db, "Reads and writes")
Rel(accounts, db, "Reads")
@enduml
