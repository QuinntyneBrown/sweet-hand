@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Send an enquiry

Person(visitor, "Visitor", "Anyone using the platform without signing in")
Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or an event")
Person(caterer, "Caterer", "Person or small business selling Caribbean food")
System(sweethand, "Sweet Hand", "Platform connecting Toronto and GTA customers with Caribbean caterers")
System_Ext(email, "Email provider", "Sends transactional email and reports bounces")

Rel(visitor, sweethand, "Fills in an enquiry form, then signs in or registers")
Rel(customer, sweethand, "Sends an enquiry to a caterer")
Rel(sweethand, email, "Sends new-enquiry email via")
Rel(email, caterer, "Delivers new-enquiry email to")
@enduml
