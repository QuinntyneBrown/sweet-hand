@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send an enquiry

Person(customer, "Customer", "Signed-in, verified customer")
Container_Boundary(web, "Sweet Hand web application") {
  Component(page, "CatererPage", "Page", "Shows Send an enquiry button")
  Component(dialog, "EnquiryFormDialog", "Dialog", "Responsive enquiry form (L2-026)")
  Component(cval, "EnquiryFormValidator", "Client rule", "Client mirror of L2-022 rules")
  Component(fit, "EnquiryFitAdvisor", "Client rule", "Shows L2-024 fit warnings")
  Component(draft, "EnquiryDraftStore", "Client state", "Keeps values across sign-in")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(pipe, "RequestPipeline", "Request pipeline", "Authentication, CSRF, Customer role")
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "POST /enquiries, drafts")
  Component(handler, "SendEnquiryHandler", "Command handler", "Creates the enquiry in one unit of work")
  Component(val, "EnquiryValidator", "Domain service", "Server-side L2-022 rules")
  Component(limits, "EnquiryLimitPolicy", "Domain policy", "L2-025 limits (limit-enquiry-abuse)")
  Component(fitp, "EnquiryFitPolicy", "Domain policy", "Computes FitWarning values")
  Component(sched, "NotificationScheduler", "Domain service", "Queues caterer email (notify-enquiry-activity)")
  Component(repo, "EnquiryRepository", "Repository", "Enquiry and draft persistence")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries, drafts, notifications")

Rel(customer, page, "Activates Send an enquiry")
Rel(page, dialog, "Opens")
Rel(dialog, cval, "Validates fields with")
Rel(dialog, fit, "Shows warnings from")
Rel(dialog, draft, "Saves and restores values with")
Rel(dialog, client, "Submits through")
Rel(client, pipe, "Calls", "JSON/HTTPS")
Rel(pipe, ep, "Forwards authorised request to")
Rel(ep, handler, "Sends SendEnquiryCommand")
Rel(handler, val, "Validates with")
Rel(handler, limits, "Checks limits with")
Rel(handler, fitp, "Computes warnings with")
Rel(handler, sched, "Queues notification with")
Rel(handler, repo, "Saves enquiry with")
Rel(repo, db, "Reads and writes")
@enduml
