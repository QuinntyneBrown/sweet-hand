@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Send an enquiry

Person(customer, "Customer", "Signed-in person in Toronto or the GTA planning a meal or an event")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages and client interactions for visitors, customers, caterers and operators")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Accounts, profiles, enquiries, messages, notifications, audit log")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Runs queued jobs and scheduled jobs")
}
System_Ext(email, "Email provider", "Sends transactional email and reports bounces")

Rel(customer, web, "Fills in and submits the enquiry form", "HTTPS")
Rel(web, api, "POST /enquiries; saves and reads drafts", "JSON/HTTPS")
Rel(api, db, "Writes enquiry, draft and queued notification")
Rel(api, queue, "Enqueues notification job")
Rel(worker, queue, "Takes notification job from")
Rel(worker, email, "Sends new-enquiry email via")
@enduml
