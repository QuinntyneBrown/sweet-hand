@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Limit enquiry abuse

Container_Boundary(web, "Sweet Hand web application") {
  Component(dialog, "EnquiryFormDialog", "Dialog", "Shows limit and duplicate messages")
  Component(widget, "BotChallengeWidget", "Page component", "Obtains challenge token")
  Component(client, "EnquiriesClient", "API client contract", "API client contract")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(pipe, "RequestPipeline", "Request pipeline", "Logs rate-limit blocks")
  Component(ep, "EnquiriesEndpoints", "Endpoint group", "POST /enquiries")
  Component(handler, "SendEnquiryHandler", "Command handler", "Runs checks before creating")
  Component(policy, "EnquiryLimitPolicy", "Domain policy", "New-account, daily and duplicate limits")
  Component(verifier, "BotProtectionVerifier", "Infrastructure", "Verifies challenge tokens")
  Component(repo, "EnquiryRepository", "Repository", "Counts and finds enquiries")
  Component(seclog, "SecurityLog", "Infrastructure", "Structured security events")
}
ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Enquiries and accounts")
System_Ext(bot, "Bot-protection provider", "Issues and verifies challenge tokens")

Rel(dialog, widget, "Embeds")
Rel(widget, bot, "Runs challenge", "HTTPS")
Rel(dialog, client, "Submits through")
Rel(client, pipe, "Calls", "JSON/HTTPS")
Rel(pipe, ep, "Forwards to")
Rel(pipe, seclog, "Records 429 blocks in")
Rel(ep, handler, "Sends SendEnquiryCommand")
Rel(handler, verifier, "Verifies token with")
Rel(verifier, bot, "Calls", "HTTPS")
Rel(handler, policy, "Checks limits with")
Rel(policy, repo, "Reads counts from")
Rel(repo, db, "Queries")
@enduml
