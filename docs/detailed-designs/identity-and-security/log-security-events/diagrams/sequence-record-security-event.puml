@startuml
title UML sequence behaviour — Record a security event and alert on repeated failures
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Caller" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "Page" as page
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "CorrelationIdStage" as corr
  participant "EndpointPolicyGuard" as guard
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "SecurityLog" as seclog
  participant "IpHasher" as iphash
  participant "LogRedactor" as redactor
  participant "AuthorisationFailureMonitor" as monitor
end box
participant "Observability platform" as obs
actor -> page : Action that calls a forbidden endpoint
page -> corr : Request
corr -> corr : Accept trusted upstream ID or create one (L2-089 AC1)
corr -> guard : Request with correlation ID
guard -> guard : Role not allowed
guard -> seclog : record(AuthorisationFailed, user, endpoint, target)
seclog -> iphash : hash(client IP) with key from secret store
iphash --> seclog : Hashed IP
seclog -> seclog : Build entry: type, user ID, hashed IP, UTC time, correlation ID (L2-084 AC1)
seclog -> redactor : redact(entry) (L2-084 AC2)
redactor --> seclog : Entry without forbidden values
seclog -> obs : Ship structured entry
seclog -> monitor : observe(event)
monitor -> monitor : Count failures for this session in last 5 minutes
opt Count reaches 10
  monitor -> obs : Raise alert to operations channel (L2-084 AC3)
end
guard --> page : 403 with X-Correlation-ID
page --> actor : Error page with correlation ID
@enduml
