@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Verify an email address and reset a password

Person(user, "Customer or caterer", "Holds an account")
Container_Boundary(web, "Sweet Hand web application") {
  Component(verify, "VerifyEmailPage", "<TO SUPPLY>", "Verification link landing")
  Component(forgot, "ForgotPasswordPage", "<TO SUPPLY>", "Reset request with challenge")
  Component(reset, "ResetPasswordPage", "<TO SUPPLY>", "New password form")
  Component(client, "IdentityClient", "API client contract", "verifyEmail, requestPasswordReset, resetPassword")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(endpoints, "IdentityEndpoints", "<TO SUPPLY>", "Verification and reset endpoints")
  Component(limiter, "RateLimiter", "<TO SUPPLY>", "5 reset requests per IP per hour (L2-082 AC3)")
  Component(verifyh, "VerifyEmailHandler", "<TO SUPPLY>", "Consumes verification tokens")
  Component(requesth, "RequestPasswordResetHandler", "<TO SUPPLY>", "Issues reset tokens")
  Component(reseth, "ResetPasswordHandler", "<TO SUPPLY>", "Consumes reset tokens, sets password")
  Component(gen, "TokenGenerator", "<TO SUPPLY>", "Secure random tokens")
  Component(th, "TokenHasher", "<TO SUPPLY>", "Hashes tokens (L2-077 AC5)")
  Component(tokens, "TokenRepository", "<TO SUPPLY>", "Token hashes and states")
  Component(sessions, "SessionStore", "<TO SUPPLY>", "Ends sessions after reset")
  Component(jobs, "JobQueue", "<TO SUPPLY>", "Email jobs")
}
ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Tokens, accounts, sessions")

Rel(user, verify, "Opens link")
Rel(user, forgot, "Uses")
Rel(user, reset, "Opens link")
Rel(verify, client, "Calls")
Rel(forgot, client, "Calls")
Rel(reset, client, "Calls")
Rel(client, limiter, "Sends request", "JSON/HTTPS")
Rel(limiter, endpoints, "Passes request within limit")
Rel(endpoints, verifyh, "Sends VerifyEmailCommand")
Rel(endpoints, requesth, "Sends RequestPasswordResetCommand")
Rel(endpoints, reseth, "Sends ResetPasswordCommand")
Rel(requesth, gen, "Generates token")
Rel(verifyh, th, "Hashes presented token")
Rel(reseth, th, "Hashes presented token")
Rel(requesth, th, "Hashes new token")
Rel(verifyh, tokens, "Finds and consumes")
Rel(requesth, tokens, "Stores hash")
Rel(reseth, tokens, "Finds and consumes")
Rel(reseth, sessions, "Revokes all sessions (L2-077 AC4)")
Rel(requesth, jobs, "Queues reset email")
Rel(reseth, jobs, "Queues confirmation email")
Rel(tokens, db, "Reads and writes")
Rel(sessions, db, "Writes")
@enduml
