@startuml
title UML sequence behaviour — Reset a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "ForgotPasswordPage" as forgot
  participant "ResetPasswordPage" as reset
  participant "IdentityClient" as client
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "RateLimiter" as limiter
  participant "IdentityEndpoints" as endpoints
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "RequestPasswordResetHandler" as requesth
  participant "ResetPasswordHandler" as reseth
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "BotProtectionVerifier" as verifier
  participant "TokenRepository" as tokens
  participant "SessionStore" as sessions
  participant "JobQueue" as jobs
end box
actor -> forgot : Enter email address
forgot -> client : requestPasswordReset(email, challenge token)
client -> limiter : POST /identity/password-reset-requests
alt Sixth request from this IP within an hour
  limiter --> client : 429 with Retry-After (L2-082 AC3)
else Within limit
  limiter -> endpoints : Pass request
  endpoints -> requesth : Send RequestPasswordResetCommand
  requesth -> verifier : Verify challenge token (L2-082 AC2)
  verifier --> requesth : Valid
  opt Email address holds an account
    requesth -> tokens : Store hash of new 30-minute token
    requesth -> jobs : Enqueue reset email
  end
  requesth --> endpoints : Same result for every address (L2-077 AC1)
  endpoints --> client : 202
end
client --> forgot : Result
forgot --> actor : "If an account exists, we've sent a reset link"
actor -> reset : Open reset link and enter new password
reset -> client : resetPassword(token, new password)
client -> endpoints : POST /identity/password-resets
endpoints -> reseth : Send ResetPasswordCommand
reseth -> tokens : findByHash(hash(token))
tokens --> reseth : PasswordResetToken or none
alt Token unconsumed and issued less than 30 minutes ago
  reseth -> reseth : Apply PasswordPolicy (L2-076 AC1), hash with Argon2id
  reseth -> tokens : Consume token and store new hash in one unit of work
  reseth -> sessions : revokeAll(account) (L2-077 AC4)
  reseth -> jobs : Enqueue confirmation email
  reseth --> endpoints : Password changed
  endpoints --> client : 200
  client --> reset : Success
  reset --> actor : Ask to sign in with the new password
else Token used or expired
  reseth --> endpoints : Rejected (L2-077 AC2)
  endpoints --> client : 400
  client --> reset : Link not valid
  reset --> actor : Ask to request a new link
end
@enduml
