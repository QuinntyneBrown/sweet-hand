@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Verify an email address and reset a password

Person(customer, "Customer", "Signed-in person planning a meal or an event")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "<TO SUPPLY>", "Server-rendered pages and client interactions")
  Container(api, "Sweet Hand API", "<TO SUPPLY>", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Accounts, sessions, tokens, consent records")
  ContainerQueue(queue, "Job queue", "<TO SUPPLY>", "Persistent queue of background jobs")
  Container(worker, "Sweet Hand background worker", "<TO SUPPLY>", "Runs queued and scheduled jobs")
}
System_Ext(email, "Email provider", "Sends transactional email")
System_Ext(bot, "Bot-protection provider", "Issues and verifies challenge tokens")

Rel(customer, web, "Opens links and submits forms", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, bot, "Verifies challenge token with", "HTTPS")
Rel(api, db, "Reads and writes token hashes, password hashes, sessions")
Rel(api, queue, "Enqueues email jobs")
Rel(worker, queue, "Takes job from")
Rel(worker, email, "Sends email via", "HTTPS")
@enduml
