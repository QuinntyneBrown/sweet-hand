@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in

Person(customer, "Customer", "Signed-in person planning a meal or an event")
Person(operator, "Operator", "Sweet Hand team member who moderates the platform")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Server-rendered pages and client interactions")
  Container(api, "Sweet Hand API", "NestJS (Node.js, TypeScript)", "HTTP endpoints, application services and domain model")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL", "Accounts, sessions, tokens, consent records")
  ContainerQueue(queue, "Job queue", "pg-boss (PostgreSQL)", "Persistent queue of background jobs")
  Container(worker, "Sweet Hand background worker", "NestJS worker (Node.js, TypeScript)", "Runs queued and scheduled jobs")
}
System_Ext(bot, "Bot-protection provider", "Issues and verifies challenge tokens")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(customer, web, "Signs in", "HTTPS")
Rel(operator, web, "Signs in and completes second factor", "HTTPS")
Rel(web, api, "Submits credentials", "JSON/HTTPS")
Rel(api, bot, "Verifies challenge token with", "HTTPS")
Rel(api, db, "Reads accounts; writes sessions and failed attempts")
Rel(api, queue, "Enqueues lockout notice")
Rel(worker, queue, "Takes job from")
Rel(worker, email, "Sends email via", "HTTPS")
@enduml
