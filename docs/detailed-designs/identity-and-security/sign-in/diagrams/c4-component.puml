@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in

Person(user, "Customer, caterer or operator", "Holds an account")
Container_Boundary(web, "Sweet Hand web application") {
  Component(page, "SignInPage", "<TO SUPPLY>", "Email and password form")
  Component(mfa, "SecondFactorPage", "<TO SUPPLY>", "TOTP or WebAuthn for operators")
  Component(client, "IdentityClient", "API client contract", "signIn, completeSecondFactor")
}
Container_Boundary(api, "Sweet Hand API") {
  Component(endpoints, "IdentityEndpoints", "<TO SUPPLY>", "POST /identity/sign-in, /identity/second-factor")
  Component(handler, "SignInHandler", "<TO SUPPLY>", "Decides each sign-in")
  Component(policy, "SignInAttemptPolicy", "Domain policy", "Account lockout and IP threshold (L2-076)")
  Component(mfahandler, "CompleteSecondFactorHandler", "<TO SUPPLY>", "Verifies operator second factor (L2-056)")
  Component(hasher, "PasswordHasher", "<TO SUPPLY>", "Verifies Argon2id hashes")
  Component(attempts, "SignInAttemptRepository", "<TO SUPPLY>", "Failed attempts per account and hashed IP")
  Component(accounts, "UserAccountRepository", "<TO SUPPLY>", "Accounts")
  Component(sessions, "SessionStore", "<TO SUPPLY>", "Creates and replaces sessions")
  Component(verifier, "BotProtectionVerifier", "<TO SUPPLY>", "Validates challenge tokens")
  Component(seclog, "SecurityLog", "<TO SUPPLY>", "Records sign-in events")
}
ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Accounts, sessions, attempts")

Rel(user, page, "Uses")
Rel(user, mfa, "Uses")
Rel(page, client, "Calls")
Rel(mfa, client, "Calls")
Rel(client, endpoints, "Sends request", "JSON/HTTPS")
Rel(endpoints, handler, "Sends SignInCommand")
Rel(endpoints, mfahandler, "Sends CompleteSecondFactorCommand")
Rel(handler, policy, "Applies")
Rel(handler, attempts, "Counts and records failures")
Rel(handler, accounts, "Finds by email")
Rel(handler, hasher, "Verifies password")
Rel(handler, verifier, "Verifies challenge when required")
Rel(handler, sessions, "Creates session, deletes old one")
Rel(handler, seclog, "Records events")
Rel(mfahandler, sessions, "Marks second factor complete")
Rel(attempts, db, "Reads and writes")
Rel(accounts, db, "Reads")
Rel(sessions, db, "Reads and writes")
@enduml
