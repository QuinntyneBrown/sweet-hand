@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the metrics dashboard

Person(operator, "Operator", "Member of the Sweet Hand team")

Container_Boundary(web, "Sweet Hand web application") {
  Component(page, "MetricsDashboardPage", "Screen", "Range and granularity controls; one chart and table per metric")
  Component(chart, "MetricsChart", "Component", "Chart for one metric")
  Component(table, "MetricsDataTable", "Component", "Accessible table of the same figures")
  Component(client, "MetricsClient", "API client contract", "Typed metrics reads")
}

Container_Boundary(api, "Sweet Hand API") {
  Component(endpoints, "OperatorMetricsEndpoints", "Endpoint group", "Operator-only metrics endpoints")
  Component(handler, "GetMetricsHandler", "Query handler", "Rolls daily aggregates into buckets")
  Component(range, "MetricsRange", "Value object", "24-month limit and bucket enumeration")
  Component(metricsRepo, "MetricsRepository", "Repository", "Daily aggregate rows")
}

Container_Boundary(worker, "Sweet Hand background worker") {
  Component(job, "AggregateMetricsJob", "Scheduled job", "Recomputes recent days")
  Component(aggregator, "DailyMetricsAggregator", "Domain service", "Counts one day from source records")
}
ContainerDb(db, "Sweet Hand database", "<TO SUPPLY>", "Source records and daily aggregates")

Rel(operator, page, "Uses", "HTTPS")
Rel(page, chart, "Renders")
Rel(page, table, "Renders")
Rel(page, client, "Requests metrics")
Rel(client, endpoints, "Calls", "JSON/HTTPS")
Rel(endpoints, handler, "Sends GetMetricsQuery")
Rel(handler, range, "Validates and enumerates buckets")
Rel(handler, metricsRepo, "Reads daily aggregates")
Rel(metricsRepo, db, "Reads")
Rel(job, aggregator, "Computes each recent day")
Rel(aggregator, db, "Reads visits, enquiries, status history")
Rel(job, db, "Upserts daily aggregates")
@enduml
