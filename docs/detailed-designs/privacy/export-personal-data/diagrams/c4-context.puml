@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Export personal data

Person(customer, "Customer", "Requests and downloads a copy of their personal information")
Person(caterer, "Caterer", "Requests and downloads a copy of their personal information")
System(sweethand, "Sweet Hand", "Platform connecting Toronto and GTA customers with Caribbean caterers")
System_Ext(email, "Email provider", "Sends transactional email")

Rel(customer, sweethand, "Requests and downloads export", "HTTPS")
Rel(caterer, sweethand, "Requests and downloads export", "HTTPS")
Rel(sweethand, email, "Sends download link via", "HTTPS")
Rel(email, customer, "Delivers download link to")
Rel(email, caterer, "Delivers download link to")
@enduml
