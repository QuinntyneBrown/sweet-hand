@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse and search the places list

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Places list page, Directory side-nav group")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Place list query with search and type counts")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/places and /summary", "JSON/HTTPS")
Rel(api, db, "Reads places", "one transaction per request")
@enduml
