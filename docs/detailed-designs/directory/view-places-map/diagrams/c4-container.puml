@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the places map

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Places map page: type toggles, A to Z list, pins, clusters, place card")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Map data: pins, trucks out today, places without a pin")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places, directoryEvents")
}
System_Ext(tiles, "Map tile provider", "<TO SUPPLY>")

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/map", "JSON/HTTPS")
Rel(api, db, "Reads places and today's occurrences", "one transaction per request")
Rel(web, tiles, "Loads tiles (map pages only)", "HTTPS")
@enduml
