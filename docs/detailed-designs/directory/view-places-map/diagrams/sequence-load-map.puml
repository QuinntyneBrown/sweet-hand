@startuml
title UML sequence behaviour — Load the places map
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "PlacesMapPage" as page
  participant "map-view.ts" as view
  participant "sh-map" as map
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "placesMapData" as uc
  participant "recurrence.ts" as rec
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
end box
actor -> page : Open /admin/places/map
page --> actor : Toggles and switch disabled, skeleton list, "Loading places on the map" (L2-122 AC3)
page -> svc : placesMap("2026-10-10")
svc -> ctrl : GET /api/operator/directory/map?date=2026-10-10
ctrl -> uc : placesMapData(req)
uc -> db : find places (not deleted, not closed) and scheduled events
uc -> rec : occurrences on the Toronto date, not cancelled or skipped
rec --> uc : Little Jamaica Saturday Market 10 a.m.–4 p.m. with Jerk Drum Truck
uc --> ctrl : ok(PlacesMap) (L2-120 AC1, AC2)
ctrl --> svc : 200
svc --> page : PlacesMap
page -> view : visible, subtitle, aToZ, pinName
page -> map : pins (A to Z tab order), legend, fit all (L2-122 AC1, AC2)
map -> map : clusterPins at current zoom (L2-120 AC4)
page --> actor : "15 places · 1 food truck out today", list A to Z (L2-120 AC5)
alt request fails (L2-122 AC4)
  svc --> page : error
  page --> actor : "Map unavailable", "We couldn’t load the map", "Try again", "Use the list"
else nothing to show (L2-120 AC6)
  page --> actor : "No places on the map yet" + "Add place"
end
@enduml
