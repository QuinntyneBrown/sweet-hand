@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the event calendar

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Calendar page: month grid, week grid, day agenda, type toggles")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Occurrences in a date range with Ontario public holidays")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "directoryEvents")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/occurrences", "JSON/HTTPS")
Rel(api, db, "Reads events", "one transaction per request")
@enduml
