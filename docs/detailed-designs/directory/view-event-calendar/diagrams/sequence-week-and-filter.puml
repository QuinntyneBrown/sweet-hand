@startuml
title UML sequence behaviour — Switch to the week and filter by type
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "CalendarPage" as page
  participant "calendar-view.ts" as view
  participant "sh-week-grid" as week
  participant "DirectoryService" as svc
end box
actor -> page : Choose "Week"
page -> svc : occurrences("2026-10-11", "2026-10-17")
svc --> page : OccurrenceRange
page -> view : layoutWeek: all-day row for multi-day, hour rows 8 a.m. to 11 p.m., overlaps side by side (L2-131 AC2, AC3)
page -> week : Render region "Week of 11 October, 8 a.m. to 11 p.m."
page --> actor : "11 – 17 Oct 2026", "{N} events this week" (L2-131 AC1)
actor -> page : Keep only Trade show and Workshop pressed
page -> view : filter in memory; subtitle (L2-130 AC7)
page --> actor : Subtitle "2 of 19 events in October · trade shows and workshops" in the month view
note over week : Below 768px the grid scrolls sideways inside its frame (L2-131 AC5)
@enduml
