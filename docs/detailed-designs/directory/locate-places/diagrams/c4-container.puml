@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Place a storefront on the map

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Place editor with pin preview; unpinned-place toast on the map")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Geocoding proxy endpoint with rate limit; position rules")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places (map position)")
}
System_Ext(geo, "Geocoder", "<TO SUPPLY>")

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/geocode", "JSON/HTTPS")
Rel(api, db, "Reads places without a position", "one transaction per request")
Rel(api, geo, "Geocodes business address", "HTTPS, server-side key")
@enduml
