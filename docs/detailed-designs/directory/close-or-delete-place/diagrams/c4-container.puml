@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Close, reopen or delete a place

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Delete-place dialog, undo toast, Reopen on the place page")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Close, reopen, delete and undo use cases")
  Container(sched, "Maintenance scheduler", "In-process timer in the API", "purgeDeletedDirectoryRecords")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places, directoryEvents, directoryDeletions, audit")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/places/{id}/... and /deletions/{id}/undo", "JSON/HTTPS")
Rel(api, db, "Writes status, deletion record and event changes; appends audit", "one transaction per request")
Rel(sched, db, "Erases records past the undo window", "hourly")
@enduml
