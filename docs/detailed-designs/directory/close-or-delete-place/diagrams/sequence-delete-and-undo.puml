@startuml
title UML sequence behaviour — Delete a place and undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "DeletePlaceDialog" as dlg
  participant "DirectoryUndo" as undo
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "deletions.ts" as uc
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
  participant "recordAudit" as audit
end box
actor -> dlg : Activate "Delete Jerk Drum Truck"
dlg -> svc : deletionImpact(id)
svc -> ctrl : GET /api/operator/directory/places/{id}/deletion-impact
ctrl -> uc : deletionImpact(req)
uc -> db : find upcoming events listing the place
uc --> dlg : 3 upcoming; cancels Jerk Drum Wednesdays (only vendor, Food truck stop)
dlg --> actor : "It’s a vendor at 3 upcoming events", focus on Cancel (L2-119 AC1, AC2)
actor -> dlg : Activate "Delete truck"
dlg --> actor : "Deleting…", aria-busy (L2-119 AC3)
dlg -> svc : deletePlace(id)
svc -> ctrl : DELETE /api/operator/directory/places/{id}
ctrl -> uc : deletePlace(req)
uc -> db : put Deletion { snapshot, removedVendorLinks, cancelledEventIds, restoreUntil = now + 15 s }
uc -> db : mark place deleted; remove upcoming vendor links; cancel sole-vendor truck stops
uc -> audit : DeletePlace
uc --> ctrl : ok(DeletionReceipt)
ctrl --> svc : 200
svc --> dlg : receipt
dlg -> undo : offer(receipt, "Jerk Drum Truck deleted", "It’s off the directory and the map.")
undo --> actor : Toast with Undo; return to list (L2-119 AC4)
alt Undo or Ctrl+Z within 10 s (timer paused on focus or hover, L2-119 AC5, AC6)
  actor -> undo : Undo
  undo -> svc : undoDeletion(deletionId)
  svc -> ctrl : POST /api/operator/directory/deletions/{id}/undo
  ctrl -> uc : undoDeletion(req)
  uc -> db : restore snapshot, vendor links and cancelled events; set undoneAt
  uc -> audit : RestorePlace
  uc --> undo : 200
  undo --> actor : Restored toast <TO SUPPLY: needs a mock>
else undo after restoreUntil (L2-119 AC7)
  uc --> undo : gone("This place can no longer be restored")
  undo --> actor : Too-late toast <TO SUPPLY: needs a mock>
end
@enduml
