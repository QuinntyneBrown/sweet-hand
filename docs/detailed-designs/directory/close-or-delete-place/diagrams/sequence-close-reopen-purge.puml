@startuml
title UML sequence behaviour — Close and reopen a place; erase expired deletions
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "PlacePage" as page
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "place-lifecycle.ts" as uc
  participant "purge.ts" as purge
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
  participant "recordAudit" as audit
end box
actor -> page : "mark it closed instead" in the delete dialog, then confirm <TO SUPPLY: needs a mock> (L2-118 AC1)
page -> svc : closePlace(id, version)
svc -> ctrl : POST /api/operator/directory/places/{id}/close
ctrl -> uc : closePlace(req)
uc -> db : put place { status: Closed, statusBeforeClose, closedOn: today, changeSummary: "marked closed" }
uc -> audit : ClosePlace (L2-118 AC5)
uc --> page : PlaceDetail
page --> actor : "Closed permanently since {date}", actions Edit, Reopen, Delete (L2-118 AC2)
actor -> page : Activate "Reopen"
page -> svc : reopenPlace(id, version)
svc -> ctrl : POST /api/operator/directory/places/{id}/reopen
ctrl -> uc : reopenPlace(req)
uc -> db : put place { status: statusBeforeClose, changeSummary: "reopened" } (L2-118 AC4)
uc -> audit : ReopenPlace
== hourly ==
purge -> db : find Deletion with restoreUntil < now and no undoneAt
purge -> db : delete place; replace its links on past events with the name as text (L2-119 AC7)
purge -> db : delete Deletion (audit entries stay, L2-119 AC8)
@enduml
