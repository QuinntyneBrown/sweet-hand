@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Add and edit an event

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Event editor dialog from the list, calendar, day agenda and food truck page")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Event rules, vendor links, audit")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "directoryEvents, places, audit")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/events and /vendors", "JSON/HTTPS")
Rel(api, db, "Reads places; writes events; appends audit entries", "one transaction per request")
@enduml
