@startuml
title UML sequence behaviour — Add a repeating event
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "PlacePage" as page
  participant "EventEditorDialog" as dialog
  participant "HttpEventsService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "events.ts" as uc
  participant "event-rules.ts" as rules
  participant "occurrences.ts" as occ
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "Geocoder" as geo
  participant "recordAudit" as audit
  database "events collection" as db
end box
actor -> page : Activate "Add stop" on Jerk Drum Truck
page -> dialog : Open with today's date, the truck as vendor,\ntype "Food truck stop" (L2-118 AC2)
actor -> dialog : Wed 14 Oct 11 a.m.–2 p.m., every week until Wed 25 Nov
dialog --> actor : "7 stops. Skip a single date from the event page." (L2-119 AC1)
actor -> dialog : Save with "Scheduled" ticked
dialog -> svc : add(EventRequest)
svc -> ctrl : POST /api/operator/events
ctrl -> ctrl : Require operator role on the server (L2-110)
ctrl -> uc : addEvent(req)
uc -> rules : validateEvent(input) in America/Toronto (L2-118 AC3–AC5)
rules --> uc : No field errors
uc -> occ : expandOccurrences(event)
occ --> uc : 7 occurrences, within 52 and 1 year (L2-119 AC2)
uc -> geo : locate(venue)
geo --> uc : Venue pin or null
uc -> db : put(event) with status Scheduled
uc -> audit : Add event, after values (L2-110 AC5)
uc --> ctrl : 201 EventDetail
ctrl --> svc : HTTP 201 JSON
svc --> dialog : Saved
dialog --> page : Close; focus returns to "Add stop"
page --> actor : Toast naming the event; stop listed under "Upcoming stops" (L2-118 AC7, AC10)
@enduml
