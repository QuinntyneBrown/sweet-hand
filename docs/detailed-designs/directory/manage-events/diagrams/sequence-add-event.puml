@startuml
title UML sequence behaviour — Add an event from a day or a food truck
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "EventEditorDialog" as dlg
  participant "event-form.ts" as form
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "addEvent / updateEvent" as uc
  participant "event-rules.ts" as rules
  participant "recurrence.ts" as rec
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
  participant "recordAudit" as audit
end box
alt from the day agenda (L2-124 AC2)
  actor -> dlg : "Add event on Sat 17 Oct" -> Starts and Ends = 2026-10-17
else from a food truck page (L2-124 AC3)
  actor -> dlg : "Add stop" -> type Food truck stop, truck as vendor
end
actor -> dlg : Fill fields, Published on, "Add event"
dlg -> form : validateEventForm(values) (L2-123 AC1 to AC3)
form --> dlg : no errors
dlg -> svc : createEvent(EventInput)
svc -> ctrl : POST /api/operator/directory/events
ctrl -> uc : addEvent(req) after roles(Operator) and CSRF (L2-133)
uc -> rules : validateEvent(input, places not closed or deleted) (L2-123 AC5, AC7)
uc -> rec : expandOccurrences(input) <= 52, each <= 1 day when repeating (L2-125 AC4)
uc -> db : put DirectoryEvent { status: Scheduled, version 1 }
uc -> audit : AddEvent (L2-124 AC10)
uc --> ctrl : created(EventDetail)
ctrl --> svc : 201
svc --> dlg : EventDetail
alt published
  dlg --> actor : Close; success toast "{title} saved" (L2-124 AC5)
else draft
  dlg --> actor : Close; warning toast "Saved as a draft" / "{title} won’t show publicly until you publish it." (L2-124 AC6)
end
@enduml
