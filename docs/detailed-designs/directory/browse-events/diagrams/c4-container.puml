@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse events and open an event

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Events list with tabs and search; event page")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Event list query, grouping inputs and event detail")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "directoryEvents, places")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/events", "JSON/HTTPS")
Rel(api, db, "Reads events and vendor places", "one transaction per request")
@enduml
