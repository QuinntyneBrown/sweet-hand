@startuml
title UML sequence behaviour — Cancel an event with a reason
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "EventPage" as page
  participant "CancelEventDialog" as dlg
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "cancelEvent" as uc
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
  participant "recordAudit" as audit
end box
actor -> page : "Cancel event"
page -> dlg : Open <TO SUPPLY: needs a mock> (L2-128 AC1)
actor -> dlg : Reason "heavy rain warning for the lakeshore", confirm
dlg -> svc : cancelEvent(id, { reason, version })
svc -> ctrl : POST /api/operator/directory/events/{id}/cancel
ctrl -> uc : cancelEvent(req)
uc -> uc : Reject an empty reason (400)
uc -> db : put event { status: Cancelled, cancellation { at, by, reason }, changeSummary: "cancelled" } (L2-128 AC4: stops not yet started)
uc -> audit : CancelEvent with reason (L2-128 AC5)
uc --> svc : EventDetail
svc --> page : updated
page --> actor : "Cancelled on Sat 3 Oct by Tomas Reyes" / "Reason: heavy rain warning for the lakeshore. ..." (L2-128 AC2)
note over page : Calendar shows "(cancelled)" struck through; map and vendor pages drop it (L2-128 AC3)
@enduml
