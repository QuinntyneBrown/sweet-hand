@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Repeat an event and skip a stop

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Repeats and Until fields; Stops section on the event page")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Recurrence expansion in America/Toronto; skip and restore")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "directoryEvents, audit")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/events/{id}/stops/{date}/skip", "JSON/HTTPS")
Rel(api, db, "Reads and writes events", "one transaction per request")
@enduml
