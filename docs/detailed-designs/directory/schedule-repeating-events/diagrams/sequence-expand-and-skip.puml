@startuml
title UML sequence behaviour — Expand stops and skip one
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "EventEditorDialog" as dlg
  participant "EventPage" as page
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "stops.ts" as uc
  participant "recurrence.ts" as rec
  participant "toronto-time.ts" as tz
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
  participant "recordAudit" as audit
end box
actor -> dlg : Repeats "Every week", Until 2026-11-25
dlg -> dlg : countStops(Wed 14 Oct, weekly, 25 Nov) = 7
dlg --> actor : "7 stops. Skip a single date from the event page." (L2-125 AC1)
note over rec, tz : On every read, stops are expanded from the stored rule;\nnothing per stop is stored except skips
actor -> page : Open the event page
page -> svc : event(id)
svc -> ctrl : GET /api/operator/directory/events/{id}
ctrl -> rec : expandOccurrences(event)
rec -> tz : toInstant("2026-11-04", "11:00") -> 16:00Z after DST ends 1 Nov (L2-125 AC2)
rec --> ctrl : 7 occurrences
ctrl --> page : EventDetail with stops
page --> actor : "7 of 7 going ahead"
actor -> page : Skip Wed 11 Nov, reason "Remembrance Day road closures" <TO SUPPLY: needs a mock>
page -> svc : skipStop(id, "2026-11-11", reason)
svc -> ctrl : POST /api/operator/directory/events/{id}/stops/2026-11-11/skip
ctrl -> uc : skipStop(req)
uc -> rec : is 2026-11-11 a stop that has not ended?
uc -> db : put event.skips += { date, reason, at, by }
uc -> audit : SkipStop
uc --> page : EventDetail
page --> actor : "6 of 7 going ahead", "Skipped · Remembrance Day road closures" (L2-125 AC5, AC6)
@enduml
