@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Add and edit a place

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Places list, place page, map card and place editor dialog")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Directory endpoints, place rules, duplicate check, audit")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places, audit")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/places", "JSON/HTTPS")
Rel(api, db, "Reads and writes places; appends audit entries", "one transaction per request")
@enduml
