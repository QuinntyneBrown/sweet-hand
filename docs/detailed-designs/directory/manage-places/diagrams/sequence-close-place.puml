@startuml
title UML sequence behaviour — Mark a place closed and undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Operator" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "PlacePage" as page
  participant "ClosePlaceDialog" as dialog
  participant "HttpPlacesService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "places.ts" as uc
  participant "place-rules.ts" as rules
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  participant "recordAudit" as audit
  database "places collection" as db
end box
actor -> page : Activate "Mark closed"
page -> dialog : Open; focus on Cancel (L2-114 AC1)
dialog --> actor : "It's a vendor at 3 upcoming events" (L2-114 AC2)
actor -> dialog : Confirm, optional reason
dialog -> svc : close(id, reason)
svc -> ctrl : POST /api/operator/places/{id}/close
ctrl -> ctrl : Require operator role on the server (L2-110)
ctrl -> uc : closePlace(req)
uc -> db : get(id)
db --> uc : Place (Listed)
uc -> db : put(status Closed, closedFrom Listed, closedAt, closedBy)
uc -> audit : Close place, reason, before and after
uc --> page : 200 PlaceDetail
page --> actor : "Closed permanently since <date>", Reopen; toast with Undo (L2-114 AC3)
actor -> page : Undo within 10 seconds (L2-114 AC4)
page -> svc : reopen(id, undo = true)
svc -> ctrl : POST /api/operator/places/{id}/reopen?undo=true
ctrl -> uc : reopenPlace(req)
uc -> db : put(status = closedFrom)
uc -> audit : Reopen place, before and after
uc --> page : 200 PlaceDetail (Listed)
note over uc, rules : A plain Reopen uses isComplete:\nListed when complete, Draft otherwise (L2-114 AC5)
@enduml
