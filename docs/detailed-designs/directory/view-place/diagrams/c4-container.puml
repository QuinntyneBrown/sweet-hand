@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a place and its opening hours

Person(operator, "Operator", "Signed in with a second factor")
System_Boundary(sweethand, "Sweet Hand") {
  Container(web, "Sweet Hand web application", "Angular 21", "Place page: location, details, hours, events, history")
  Container(api, "Sweet Hand API", "NestJS 11 on Node.js 22", "Place detail query with hours, events and history")
  ContainerDb(db, "Sweet Hand database", "PostgreSQL, JSON document collections (ADR 0008)", "places, directoryEvents")
}

Rel(operator, web, "Uses", "HTTPS")
Rel(web, api, "Calls /api/operator/directory/places/{id}", "JSON/HTTPS")
Rel(api, db, "Reads the place and the events that list it", "one transaction per request")
@enduml
