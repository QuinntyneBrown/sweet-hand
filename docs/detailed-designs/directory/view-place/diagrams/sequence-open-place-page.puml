@startuml
title UML sequence behaviour — Open a place page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Frontend — Sweet Hand web application (operator console)" #E0F2FE
  participant "PlacePage" as page
  participant "hours-view.ts" as hv
  participant "DirectoryService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "DirectoryController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain (backend/src/directory)" #ECFDF3
  participant "placeDetail" as uc
  participant "hours.ts" as hours
  participant "recurrence.ts" as rec
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
end box
actor -> page : Open /admin/places/{id}
page --> actor : "Loading place" (L2-116 AC8)
page -> svc : place(id)
svc -> ctrl : GET /api/operator/directory/places/{id}
ctrl -> uc : placeDetail(req)
uc -> db : get(id)
alt missing or deleted (L2-116 AC9)
  uc --> ctrl : notFound()
  ctrl --> svc : 404
  svc --> page : not found
  page --> actor : Not-found page
else found
  uc -> db : find events listing the place as vendor
  uc -> rec : expandOccurrences(events, today .. +60 days)
  rec --> uc : upcoming stops, today stop for a truck (L2-116 AC3)
  uc -> hours : openStatusAt(hours, now in America/Toronto) (L2-117 AC3, AC5)
  uc --> ctrl : ok(PlaceDetail)
  ctrl --> svc : 200
  svc --> page : PlaceDetail
  page -> hv : weekRows, exceptionCaption (L2-117 AC1, AC2)
  page --> actor : Location or Where it is, Details, Hours, At events, History (L2-116)
end
@enduml
