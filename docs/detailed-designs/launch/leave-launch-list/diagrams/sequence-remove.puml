@startuml
title UML sequence behaviour — Remove an address from the page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Person" as actor
box "Frontend — Launch site" #E0F2FE
  participant "LaunchPage" as page
  participant "LaunchUrlState" as url
  participant "LaunchListService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "LaunchListController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "leaveLaunchList" as uc
  participant "eraseEntry" as erase
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
end box
alt from the confirmed state (L2-100 AC1)
  actor -> page : Activate "Remove my email"
  page -> svc : remove(removalToken held in memory)
else from a removal link (L2-100 AC3)
  actor -> page : Open /?remove=<token>
  page -> url : read(location)
  url --> page : { kind: 'remove', token }
  page -> svc : remove(token)
end
svc -> ctrl : POST /api/launch-list/removals { token }
ctrl -> uc : leaveLaunchList(req)
uc -> db : recordEvent('launch-token', ip): over 30/h -> 429
uc -> db : findOne({ kind: 'remove', tokenHash })
alt entry found
  uc -> erase : eraseEntry(entry) (L2-100 AC4)
  erase -> db : delete entry, all its tokens, queued launch-* emails
  uc --> ctrl : 200 { email }
else no entry (L2-100 AC5)
  uc --> ctrl : 200 {}
end
ctrl --> svc : 200
svc --> page : LaunchRemoval
page -> page : panel = form (empty), notice = unsubscribed
page --> actor : "You’re off the list", "We’ve deleted {email}." or no address line
page -> url : clear() (L2-100 AC6)
@enduml
