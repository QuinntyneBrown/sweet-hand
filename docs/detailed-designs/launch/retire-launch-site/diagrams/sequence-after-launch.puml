@startuml
title UML sequence behaviour — Launch links after launch
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Person" as actor
box "Frontend — Sweet Hand web application" #E0F2FE
  participant "launchLinkRedirect" as guard
  participant "LaunchListRemovalPage" as page
  participant "LaunchListService" as svc
end box
box "Backend — Sweet Hand API application" #D1FADF
  participant "LaunchListController" as ctrl
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "leaveLaunchList" as leave
end box
alt removal link (L2-102 AC3)
  actor -> guard : Open /?remove=<token> (after 303 from /api/launch-list/unsubscribe)
  guard --> actor : Redirect to /launch-list/remove?token=<token>
  actor -> page : Load
  page -> svc : remove(token)
  svc -> ctrl : POST /api/launch-list/removals
  ctrl -> leave : leaveLaunchList(req)
  leave --> ctrl : 200 { email } or 200 {} once the list is deleted
  ctrl --> svc : 200
  svc --> page : LaunchRemoval
  page --> actor : "You’re off the list" (address line only when returned)
else confirmation link (L2-102 AC4)
  actor -> guard : Open /?confirmed=<token>
  guard --> actor : Redirect to / with no query; nothing is sent, nothing confirmed
end
@enduml
