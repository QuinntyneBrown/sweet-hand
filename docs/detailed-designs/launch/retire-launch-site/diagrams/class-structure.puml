}
abstract class LaunchListService {
  +remove(token: string): Observable<LaunchRemoval>
}
class LaunchRemoval {
  +email?: string
}
class LaunchState <<document>> {
  +launchEmailRunAt?: string
  +launchDay?: string
}
class "sign-up.ts / confirm.ts" as uc <<use cases>> {
  +joinLaunchList(req): Promise<Reply>
  +confirmLaunchListEmail(req): Promise<Reply>
}
g ..> LaunchListRemovalPage : redirects to
LaunchListRemovalPage ..> LaunchListService : injects
LaunchListService ..> LaunchRemoval
uc --> LaunchState : 410 when launchEmailRunAt is set
