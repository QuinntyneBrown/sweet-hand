@startuml
title UML sequence behaviour — Delete the launch list 30 days after launch
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
box "Backend — Sweet Hand API application" #D1FADF
  participant "main.ts worker interval" as worker
end box
box "Backend — Sweet Hand Application and Domain" #ECFDF3
  participant "sweepLaunchList" as sweep
end box
box "Backend — Sweet Hand Infrastructure" #FFF4E5
  database "Sweet Hand database" as db
end box
worker -> sweep : every hour
sweep -> db : get launchState
alt launchDay + 30 days has passed (L2-101 AC6)
  sweep -> db : delete every launchList entry and launchListToken
  sweep -> db : delete every launch-* outbox email
  sweep --> worker : { listDeleted: n } logged as a count only
else otherwise
  sweep --> worker : unconfirmed sweep only (confirm-launch-list-email)
end
@enduml
