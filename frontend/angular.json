{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "sweet-hand": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/sweet-hand",
      "sourceRoot": "projects/sweet-hand/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sweet-hand/src/main.ts",
            "tsConfig": "projects/sweet-hand/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sweet-hand/public"
              }
            ],
            "styles": [
              "../docs/design-system/tokens/tokens.css",
              "../docs/design-system/assets/components.css",
              "projects/sweet-hand/src/styles.css"
            ],
            "polyfills": [
              "@angular/localize/init"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "750kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sweet-hand:build:production"
            },
            "development": {
              "buildTarget": "sweet-hand:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "sweet-hand:build",
            "outputPath": "projects/sweet-hand/src/locale"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/sweet-hand/src/**/*.ts",
              "projects/sweet-hand/src/**/*.html",
              "projects/components/src/**/*.ts",
              "projects/components/src/**/*.html",
              "projects/api/src/**/*.ts"
            ]
          }
        }
      },
      "i18n": {
        "sourceLocale": "en-CA"
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "sh",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "sh",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "launch": {
      "projectType": "application",
      "root": "projects/launch",
      "sourceRoot": "projects/launch/src",
      "prefix": "launch",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/launch/src/main.ts",
            "server": "projects/launch/src/main.server.ts",
            "outputMode": "static",
            "outputPath": "dist/launch",
            "tsConfig": "projects/launch/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/launch/public"
              }
            ],
            "styles": [
              "../docs/design-system/tokens/tokens.css",
              "../docs/design-system/assets/components.css"
            ],
            "polyfills": [
              "@angular/localize/init"
            ],
            "define": {
              "LAUNCH_SITE_URL": "'https://sweethand.example'",
              "LAUNCH_CONTACT_EMAIL": "'hello@sweethand.example'",
              "LAUNCH_TURNSTILE_SITE_KEY": "''"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "380kB",
                  "maximumError": "400kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "launch:build:production"
            },
            "development": {
              "buildTarget": "launch:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "launch:build",
            "outputPath": "projects/launch/src/locale"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/launch/src/**/*.ts",
              "projects/launch/src/**/*.html"
            ]
          }
        }
      },
      "i18n": {
        "sourceLocale": "en-CA"
      }
    }
  }
}
